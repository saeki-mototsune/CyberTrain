#!/usr/bin/env ruby
# The `cybertrain` command as installed by `gem install cybertrain`: the CLI
# sources are plain Ruby that also run under CRuby (bin/cybertrain.rb is the
# same entry point, compiled by spin).
require "cybertrain/cli"

# Ctrl-C reaches the whole process group: the child (`spin run NAME`, a
# build) stops itself, and CRuby raises Interrupt out of `system` here.
# Build.run's ensure has restored gen/views.rb by the time it arrives.
begin
  status = Cybertrain::CLI.run(ARGV)
rescue Interrupt
  status = 130
end
exit(status)

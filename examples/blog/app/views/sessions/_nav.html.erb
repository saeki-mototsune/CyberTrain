<%# locals: () %>
<nav class="session">
  <% if @current_user %>
    <span><%= @current_user.email_address %></span>
    <%= link_to t(".account"), edit_account_path %>
    <%= button_to t(".sign_out"), session_path, method: :delete %>
  <% else %>
    <%= link_to t(".sign_in"), new_session_path %>
  <% end %>
</nav>

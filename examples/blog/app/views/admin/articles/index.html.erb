<h1><%= t(".title") %></h1>

<p class="admin-count"><%= t(".count", count: @article_count, number: number_with_delimiter(@article_count)) %></p>

<table>
  <thead>
    <tr>
      <th><%= t(".article_title") %></th>
      <th><%= t(".created") %></th>
      <th><%= t(".comments") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= time_tag article.created_at, format: :long %></td>
        <td><%= number_with_delimiter(article.comments.size) %></td>
        <td><%= button_to t(".delete"), admin_article_path(article), method: :delete %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to t(".jobs"), "/admin/jobs" %> | <%= link_to t(".back"), articles_path %></p>

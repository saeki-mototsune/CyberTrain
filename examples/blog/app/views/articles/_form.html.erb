<%# locals: (article:) %>
<%= form_with(model: article, multipart: true) do |f| %>
  <% if article.errors.any? %>
    <div id="error_explanation">
      <h2><%= t(".error_header", count: article.errors.count) %></h2>
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :body %>
    <%= f.text_area :body %>
  </div>

  <div class="field">
    <%= f.label :cover %>
    <%= f.file_field :cover, accept: "image/png,image/jpeg,image/gif,image/webp" %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

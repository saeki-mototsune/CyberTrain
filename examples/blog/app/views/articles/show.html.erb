<h1><%= @article.title %></h1>
<% if @article.cover_attached? %><p><img src="<%= @article.cover_url %>" alt="<%= @article.cover_filename %>"></p><% end %>

<p><%= @article.body %></p>

<p class="dates">Written <%= time_tag @article.created_at, format: :long %></p>

<p>
  <%= link_to "Edit", edit_article_path(@article) %> |
  <%= link_to "Back to articles", articles_path %>
</p>

<%= button_to "Destroy this article", article_path(@article), method: :delete %>

<% if admin? %>
  <p><%= link_to "Manage articles", admin_articles_path %></p>
<% end %>

<h2>Comments</h2>

<%# New comments arrive over SSE: CommentsController#create appends to #comments. %>
<%= turbo_stream_from @article %>

<div id="comments">
  <% @article.comments.each do |comment| %>
    <%= render component: "comment", comment: comment %>
  <% end %>
</div>

<h2>Add a comment:</h2>

<%# create.turbo_stream.erb puts an empty form back in here. %>
<div id="comment_form">
  <%= render "comments/form", comment: @comment %>
</div>

<h1><%= @article.title %></h1>
<% if @article.cover_attached? %><p><img src="<%= @article.cover_url %>" alt="<%= @article.cover_filename %>"></p><% end %>

<p><%= @article.body %></p>

<p class="dates"><%= t(".written") %> <%= time_tag @article.created_at, format: :long %></p>

<p>
  <%= link_to t(".edit"), edit_article_path(@article) %> |
  <%= link_to t(".back"), articles_path %>
</p>

<%= button_to t(".destroy"), article_path(@article), method: :delete %>

<% if admin? %>
  <p><%= link_to t(".manage"), admin_articles_path %></p>
<% end %>

<h2><%= t(".comments") %></h2>

<%# New comments arrive over SSE: CommentsController#create appends to #comments. %>
<%= turbo_stream_from @article %>

<div id="comments">
  <% @article.comments.each do |comment| %>
    <%= render component: "comment", comment: comment %>
  <% end %>
</div>

<h2><%= t(".add_comment") %></h2>

<%# create.turbo_stream.erb puts an empty form back in here. %>
<div id="comment_form">
  <%= render "comments/form", comment: @comment %>
</div>

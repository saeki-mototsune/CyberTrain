<h1>Articles</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Body</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.body %></td>
        <td><%= link_to "Show", article_path(article) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "New article", new_article_path %></p>

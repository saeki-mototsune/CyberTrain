<!DOCTYPE html>
<html>
  <head>
    <title>Blog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# app/assets/stylesheets/application.css, digested by `spin run gen`. %>
    <%= stylesheet_link_tag "application" %>
    <%# The import map of config/importmap.rb (Turbo, pinned from jsDelivr,
        and app/javascript/application.js), with this response's CSP nonce.
        Turbo makes <turbo-stream-source> live and answers forms with
        Turbo Streams. %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="brand"><%= link_to "Blog", root_path %></header>
    <main>
      <% if flash[:notice] %>
        <p class="notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>

<!DOCTYPE html>
<html lang="<%= html_lang %>">
  <head>
    <title><%= t(".title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# app/assets/stylesheets/application.css, digested by `spin run gen`. %>
    <%= stylesheet_link_tag "application" %>
    <%# The import map of config/importmap.rb (Turbo, pinned from jsDelivr,
        and app/javascript/application.js), with this response's CSP nonce.
        Turbo makes <turbo-stream-source> live and answers forms with
        Turbo Streams. %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="brand"><%= link_to t(".brand"), root_path %></header>
    <%# This page in either language: ?locale= picks it, and
        ApplicationController#set_locale keeps it in a cookie. %>
    <nav class="locale">
      <%= link_to t(".english"), path_in_locale("en") %> |
      <%= link_to t(".japanese"), path_in_locale("ja") %>
    </nav>
    <main>
      <%= render "sessions/nav" %>
      <% if flash[:notice] %>
        <p class="notice"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>

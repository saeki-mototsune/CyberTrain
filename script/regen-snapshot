#!/bin/sh
# Regenerate the .expected snapshot of test programs that link SQLite/FFI and
# therefore cannot run under CRuby (so "spin test --regen" is not an option).
# For each file it runs "spin test <file>" to build ./build/test/<name> (the
# exit status is ignored: the current snapshot may well be stale), captures the
# binary's stdout and stderr, which spin test compares together, into
# test/<name>.rb.expected and prints the git diff --stat
# of that snapshot so you can review what changed. The old binary is removed
# first, so a compile failure leaves no binary to run ("was not built", exit 1)
# instead of turning a stale one's output into the new snapshot. A run that
# exits non-zero or prints one of the harness's failure lines ("FAIL <test>: "
# / "ERR  <test>: ", cybertrain/test.rb; a test's own output that merely starts
# with FAIL is not one) is not kept: the output goes to a temporary file that
# replaces the snapshot only on success, so a failing test can never be
# enshrined as its own expectation.
#
# usage: script/regen-snapshot test/<name>.rb [...]
set -u

if [ "$#" -eq 0 ]; then
  echo "usage: script/regen-snapshot test/<name>.rb [...]" >&2
  exit 2
fi

cd "$(dirname "$0")/.." || exit 1

status=0
for file in "$@"; do
  name=$(basename "$file" .rb)
  bin="./build/test/$name"
  rm -f "$bin"
  spin test "$file" || true
  if [ ! -x "$bin" ]; then
    echo "regen-snapshot: $bin was not built" >&2
    status=1
    continue
  fi
  tmp="test/$name.rb.expected.tmp"
  "$bin" > "$tmp" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ] || grep -q -e '^FAIL [^:]*: ' -e '^ERR  [^:]*: ' "$tmp"; then
    echo "regen-snapshot: $bin failed (exit $rc); kept the previous test/$name.rb.expected" >&2
    grep -e '^FAIL [^:]*: ' -e '^ERR  [^:]*: ' "$tmp" >&2
    rm -f "$tmp"
    status=1
    continue
  fi
  mv "$tmp" "test/$name.rb.expected"
  git diff --stat -- "test/$name.rb.expected"
done
exit "$status"

#!/bin/sh
# Builds the API reference (YARD) into site/api/, which the Pages workflow
# publishes as https://www.cybertrain.dev/api/. What goes
# in, and how, is .yardopts: the framework's methods marked `@api public`,
# the generated-code descriptions in docs/api/stubs/, docs/api/README.md as
# the front page. The guides (docs/guide/) are not part of it: script/guide-pages
# builds them into the site.
# docs/api/yard_setup.rb holds the filter and the Markdown setup. site/api/ is not committed.
#
# Any YARD warning (an unknown tag, a {Link} that resolves to nothing) fails
# the build, so a broken reference is caught by CI (.github/workflows/ci.yml)
# rather than shipped. Runs under CRuby; needs the yard, kramdown and
# kramdown-parser-gfm gems (the install line is printed when one is missing).
#
# usage: script/api-docs            # then open site/api/index.html
set -u

cd "$(dirname "$0")/.." || exit 1

for gem in yard kramdown kramdown-parser-gfm; do
  if ! ruby -e "gem '$gem'" 2>/dev/null; then
    echo "script/api-docs: the $gem gem is missing; install the three with:" >&2
    echo "  gem install yard kramdown kramdown-parser-gfm" >&2
    exit 1
  fi
done

# The HTTP layer is spinel-http (docs/design.md D91), whose files keep the
# public methods' doc comments; cybertrain's cybertrain/http/*.rb are alias
# shims that .yardopts leaves out. Applications name those classes
# Cybertrain::Request, Cybertrain::Params, ... (one class under two names),
# and cybertrain's own comments and docs/api/README.md link them so, and
# cybertrain/params.rb and request_format.rb add to them. So the reference
# reads a copy of spinel-http/*.rb (the checkout spin.lock pins, found by
# script/spinel_http_path.rb) with `SpinelHttp` read as `Cybertrain`, and
# each class has one page with all its public methods. The entry file
# spinel-http.rb is not read (its VERSION is spinel-http's), and a comment
# line that starts with an ivar (`@headers in place`) gets it in backticks
# so YARD does not take it for a tag.
http=$(ruby script/spinel_http_path.rb) || exit 1
copy=tmp/api-docs/spinel-http
rm -rf site/api "$copy"
mkdir -p "$copy" || exit 1
ruby -ryard -e '
  src, dst = ARGV
  Dir[File.join(src, "spinel-http", "*.rb")].sort.each do |path|
    text = File.read(path).gsub("SpinelHttp", "Cybertrain")
    text = text.gsub(/^(\s*#\s+)@(\w+)/) do
      YARD::Tags::Library.instance.has_tag?($2) ? $& : "#{$1}`@#{$2}`"
    end
    File.write(File.join(dst, File.basename(path)), text)
  end' "$http" "$copy" || exit 1
# Gem.bin_path, not `yard` on PATH: a version manager may not have put the
# gem's executable there. The files given here are read with .yardopts' own.
exec ruby -e 'load Gem.bin_path("yard", "yard")' -- doc --no-save --fail-on-warning --no-progress "$copy"/*.rb

#!/usr/bin/env bash
# Drives an application made by `cybertrain generate authentication` from
# end to end, once per VARIANT: a new app (this checkout as its framework)
# with a scaffold, the generator, `db migrate`, `build`, `spin run gen --
# --check`, every test the app has run by `cybertrain test` (one program),
# then the built binary served on a free port and probed with curl and
# the user command, and a password reset whose mail the server's job thread
# sends to an SMTP receiver (cybertrain/test/smtp_receiver.rb, run by
# CRuby) on another free port, then the account page (a new address and
# password, which signs a second browser out, then the account deleted
# with the password). The first failure stops it with a non-zero
# status and leaves the app's directory in place to look at.
#
#   signup       generate authentication (the sign-up page)
#   invite       generate authentication --invite-only (the boot warning and
#                /setup with its one-time token while no user exists, the
#                user command reading the password from stdin, /setup gone
#                once a user exists)
#   confirmable  generate authentication --confirmable: a sign-up whose mailed
#                link confirms the address (the sign-in refused until then),
#                and a new address that takes effect once its own link is
#                opened
#   upgrade04    the three below, one after another. Each starts from its
#                own copy of test/fixtures/auth_04_app (a sign-up app v0.4.1
#                generated), so each also runs on its own:
#   upgrade04-patch
#                today's generator run over the copy: its printed diffs
#                applied with patch -p1 and 0.4's test files that the
#                generator names as replaced deleted, then db migrate, build
#                and `cybertrain test`
#   upgrade04-force
#                the same with --force (which deletes them itself), then
#                the tree compared with a patched copy's, file for file:
#                the same files with the same bytes but for the
#                generator's output, patch's log and the add-columns
#                migration's timestamp. Not built: the tree that compiles
#                is upgrade04-patch's, which CI runs in the same leg.
#                (Until 2026-11-24 it was built and tested on its own; run
#                alone, it now shows only that --force writes what patch
#                does.)
#   upgrade04-confirmable
#                a copy migrated by 0.4's migrations with a user in it, run
#                with --confirmable: the add-columns migration keeps the
#                user and counts it as confirmed; with every diff applied
#                but the sessions controller's, the concern still signs no
#                unconfirmed account in (one test, `cybertrain test FILE`,
#                whose program compiles the app with 0.4's controller;
#                until 2026-11-24 `cybertrain build` also made that state's
#                release binary, which no longer is); with that one
#                applied too, the app builds and every test passes (not
#                migrated again: that diff adds no migration, and until
#                2026-11-24 the second `db migrate` and `db status` there
#                had nothing to apply)
#
# The served variants also check what a released app relies on: spin.lock
# written by `cybertrain new`, `db status`, the digested stylesheet served
# with an immutable cache-control, /up.html (Kamal's health check) and the
# binary starting in the production environment.
#
# Every line of progress carries the seconds since its variant started
# (`+Ns`), so a CI log shows where the minutes go.
#
# The scenarios are in script/e2e.d/: auth_served.sh (signup, invite,
# confirmable, one function a part of what is served), auth_upgrade04.sh
# (the three upgrades), auth.sh (what they share: build_and_test, the SMTP
# receiver, the fixture's copies), on lib.sh (what every end-to-end script
# shares: progress lines, failures, the CLI, the server).
#
# Runs locally with the pinned toolchain (the CLI puts it on PATH, installing
# it the first time) and in CI (.github/workflows/ci.yml, the `e2e` job: one
# leg per variant, and the `e2e-macos` job's sign-up). Each variant builds
# the app and its tests: minutes, not seconds.
#
# The CLI is this checkout's (`ruby -I. exe/cybertrain`), or, with
# CYBERTRAIN_E2E_CLI=gem, the `cybertrain` on PATH: the gem setup-spinel
# builds and installs, so that one CI leg runs what users install, which
# carries only the files cybertrain.gemspec lists.
#
# usage: script/auth-e2e VARIANT...
#        CYBERTRAIN_E2E_CLI=gem script/auth-e2e VARIANT...
set -euo pipefail

# shellcheck source=script/e2e.d/lib.sh
. "$(dirname "$0")/e2e.d/lib.sh"
e2e_init auth-e2e
SECRET=auth-e2e-secret-auth-e2e-secret-auth-e2e

VARIANTS="signup, invite, confirmable, upgrade04, upgrade04-patch, upgrade04-force, upgrade04-confirmable"
if [ $# -eq 0 ]; then
  echo "usage: script/auth-e2e VARIANT... ($VARIANTS)" >&2
  exit 2
fi
for variant in "$@"; do
  case "$variant" in
    signup | invite | confirmable | upgrade04 | upgrade04-patch | upgrade04-force | upgrade04-confirmable) ;;
    *)
      echo "auth-e2e: unknown variant $variant ($VARIANTS)" >&2
      exit 2
      ;;
  esac
done

e2e_use_cli

# shellcheck source=script/e2e.d/auth.sh
. "$ROOT/script/e2e.d/auth.sh"
# shellcheck source=script/e2e.d/auth_served.sh
. "$ROOT/script/e2e.d/auth_served.sh"
# shellcheck source=script/e2e.d/auth_upgrade04.sh
. "$ROOT/script/e2e.d/auth_upgrade04.sh"

# `run_upgrade04 SCENARIO...`: patch, force, confirmable.
run_upgrade04() {
  WORK=$(e2e_workdir "auth-e2e-$VARIANT")
  E2E_LEFT=$WORK
  SERVER_LOG=""
  step "the 0.4 app's copies in $WORK"
  for scenario in "$@"; do
    "upgrade04_$scenario"
  done
  cd "$ROOT"
  rm -rf "$WORK"
  step "PASS"
}

# signup, invite, confirmable: the app generated, built and tested, then
# served (script/e2e.d/auth_served.sh).
run_served() {
  local flag="" base port jar reset_jar setup_token="" mails reset_mail
  [ "$VARIANT" = "invite" ] && flag="--invite-only"
  [ "$VARIANT" = "confirmable" ] && flag="--confirmable"
  WORK=$(e2e_workdir "auth-e2e-$VARIANT")
  E2E_LEFT=$WORK
  SERVER_LOG=""
  served_generate
  build_and_test
  served_start
  served_signed_out
  if [ "$VARIANT" = "confirmable" ]; then served_confirmable_signup; fi
  served_user_command
  served_admin
  served_password_reset
  served_account
  stop_server
  unset CYBERTRAIN_SECRET_KEY_BASE
  cd "$ROOT"
  rm -rf "$WORK"
  step "PASS"
}

run_variant() {
  e2e_scenario "$VARIANT"
  case "$VARIANT" in
    upgrade04) run_upgrade04 patch force confirmable ;;
    upgrade04-*) run_upgrade04 "${VARIANT#upgrade04-}" ;;
    *) run_served ;;
  esac
}

for VARIANT in "$@"; do
  run_variant
done
E2E_SCENARIO=""
echo "auth-e2e: PASS ($*) in ${SECONDS}s"

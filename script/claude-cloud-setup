#!/bin/bash
# Setup script for a Claude Code cloud environment (claude.ai/code) that
# works on this repository. Paste the whole file into the environment's
# "Setup script" field; it does not read the checkout, so it works whether
# or not the repository has been cloned when it runs.
#
# The cloud VM (Ubuntu 24.04, root) already has Ruby 3.3, a C toolchain,
# make, git, curl and the SQLite headers; what it lacks is Spinel. This
# installs a Spinel release into the copy the CLI manages,
# ~/.cybertrain/spinel/<tag>, writes the stamp the CLI checks, and links
# `spinel` and `spin` into ~/.cybertrain/bin and /usr/local/bin, so both
# `spin test` and `cybertrain spin test` work without touching PATH.
# It also installs the gems script/api-docs needs (as CI does).
#
# Fast path, in order:
#   1. the environment's filesystem cache: it is saved after a run that
#      finishes within about five minutes, so a later session finds the
#      release already installed and does nothing (about a second);
#   2. a prebuilt tree: when cybertrain is released, the Release workflow
#      (.github/workflows/spinel-prebuilt.yml) builds the fork's latest
#      release in an ubuntu:24.04 container (the cloud VM's OS) and attaches
#      it to the release; it is downloaded from the latest cybertrain
#      release, checked against its sha256 and unpacked (seconds);
#   3. a source build, as `cybertrain setup` does it (git clone, make deps,
#      make, make install; about four minutes), when the latest cybertrain
#      release carries no build of this Spinel release (the fork released
#      again since) or SPINEL_BUILD_FROM_SOURCE=1.
# The gems are installed in the background meanwhile.
#
# Spinel comes from the saeki-mototsune fork (SPINEL_GIT, which must be
# Cybertrain::SPINEL_REPOSITORY plus ".git"; script/gate checks it), and the
# release built is the fork's latest one, looked up with `git ls-remote` on
# every run: its newest tag shaped like a release (YYYY.MM.DD or
# YYYY.MM.DD.N). An unchanged release is not rebuilt, so a cached
# environment only rebuilds after the fork publishes a new one. Set
# SPINEL_TAG in the environment's variables to build a given tag instead.
# If the lookup fails (no network), the newest release already installed
# is used. The latest release can be newer than Cybertrain::SPINEL_TAG,
# which `cybertrain setup` and `cybertrain spin ...` build and use.
set -euo pipefail

SPINEL_GIT="https://github.com/saeki-mototsune/spinel.git"
CT_HOME="${CYBERTRAIN_HOME:-$HOME/.cybertrain}"
# The latest cybertrain release, which carries prebuilt Spinel
# (.github/workflows/spinel-prebuilt.yml).
PREBUILT_BASE="https://github.com/saeki-mototsune/CyberTrain/releases/latest/download"
RELEASE_TAG_RE='^[0-9]{4}\.[0-9]{2}\.[0-9]{2}(\.[0-9]+)?$'

# The newest release tag of the fork, or "" when it cannot be reached
# within 30 seconds (the lookup normally takes a few).
latest_release_tag() {
  timeout 30 git ls-remote --tags --refs "$SPINEL_GIT" 2> /dev/null \
    | sed 's#.*refs/tags/##' | grep -E "$RELEASE_TAG_RE" | sort -V | tail -n 1
}

# The newest release with a complete install under $CT_HOME/spinel, or "".
latest_installed_tag() {
  local dir
  for dir in "$CT_HOME"/spinel/*/; do
    [ -f "$dir.cybertrain-complete" ] && basename "$dir"
  done 2> /dev/null | grep -E "$RELEASE_TAG_RE" | sort -V | tail -n 1
}

if [ -z "${SPINEL_TAG:-}" ]; then
  SPINEL_TAG="$(latest_release_tag || true)"
  if [ -n "$SPINEL_TAG" ]; then
    echo "==> latest Spinel release of $SPINEL_GIT: $SPINEL_TAG"
  else
    SPINEL_TAG="$(latest_installed_tag || true)"
    [ -n "$SPINEL_TAG" ] || { echo "cannot list the releases of $SPINEL_GIT, and no Spinel is installed"; exit 1; }
    echo "warning: cannot list the releases of $SPINEL_GIT; using installed Spinel $SPINEL_TAG"
  fi
fi
PREFIX="$CT_HOME/spinel/$SPINEL_TAG"
STAMP="$PREFIX/.cybertrain-complete"

# System packages: normally all present already, so apt runs only when
# one is missing.
missing=()
for pkg in build-essential git curl libsqlite3-dev zlib1g-dev libssl-dev sqlite3; do
  dpkg -s "$pkg" > /dev/null 2>&1 || missing+=("$pkg")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "==> apt-get install ${missing[*]}"
  apt-get update -qq > /dev/null
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" > /dev/null
fi

# Gems for script/api-docs, in the background while Spinel is installed
# and only when one is missing (a cached environment has them); a failure
# here does not stop the session from starting.
gems_missing=()
for gem_name in yard kramdown kramdown-parser-gfm; do
  gem list -i "^${gem_name}\$" > /dev/null 2>&1 || gems_missing+=("$gem_name")
done
if [ "${#gems_missing[@]}" -gt 0 ]; then
  gem install --no-document "${gems_missing[@]}" > /tmp/claude-setup-gems.log 2>&1 &
  gems_pid=$!
else
  gems_pid=""
fi

# The prebuilt tree .github/workflows/spinel-prebuilt.yml publishes for
# $SPINEL_TAG, unpacked into $PREFIX; fails (and leaves no $PREFIX) when
# there is none, the checksum does not match or it does not run.
install_prebuilt() {
  local asset="spinel-$SPINEL_TAG-linux-$(uname -m).tar.gz"
  local url="$PREBUILT_BASE/$asset"
  local tmp
  tmp="$(mktemp -d)"
  curl -fsL --retry 3 --connect-timeout 10 -o "$tmp/$asset" "$url" \
    && curl -fsL --retry 3 --connect-timeout 10 -o "$tmp/$asset.sha256" "$url.sha256" \
    && (cd "$tmp" && sha256sum -c --quiet "$asset.sha256") \
    && mkdir -p "$tmp/x" && tar -C "$tmp/x" -xzf "$tmp/$asset" \
    && "$tmp/x/$SPINEL_TAG/bin/spinel" --version 2> /dev/null | grep -q "^spinel $SPINEL_TAG (" \
    && rm -rf "$PREFIX" && mkdir -p "$(dirname "$PREFIX")" && mv "$tmp/x/$SPINEL_TAG" "$PREFIX"
  local status=$?
  rm -rf "$tmp"
  return "$status"
}

# `cybertrain setup`'s way: git clone, make deps, make, make install.
build_from_source() {
  local src log
  src="$(mktemp -d)"
  log="$CT_HOME/log/spinel-$SPINEL_TAG-build.log"
  mkdir -p "$(dirname "$log")"
  {
    git clone -q --depth 1 --branch "$SPINEL_TAG" "$SPINEL_GIT" "$src/spinel"
    make -C "$src/spinel" deps
    make -C "$src/spinel" -j"$(nproc)"
    make -C "$src/spinel" install PREFIX="$PREFIX"
  } > "$log" 2>&1 || { echo "Spinel build failed; last lines of $log:"; tail -n 25 "$log"; exit 1; }
  rm -rf "$src"
}

# Spinel, unless a complete copy of the release is already there: the
# prebuilt one when it exists, else built from source.
if [ -f "$STAMP" ] && "$PREFIX/bin/spinel" --version 2>/dev/null | grep -q "^spinel $SPINEL_TAG ("; then
  echo "==> Spinel $SPINEL_TAG already installed in $PREFIX"
else
  rm -f "$STAMP"
  if [ "${SPINEL_BUILD_FROM_SOURCE:-0}" != "1" ] && install_prebuilt; then
    echo "==> installed prebuilt Spinel $SPINEL_TAG into $PREFIX"
  else
    echo "==> no usable prebuilt Spinel $SPINEL_TAG; building it from source into $PREFIX"
    build_from_source
  fi
  echo "$SPINEL_TAG" > "$STAMP"
fi

mkdir -p "$CT_HOME/bin"
for tool in spinel spin; do
  ln -sfn "$PREFIX/bin/$tool" "$CT_HOME/bin/$tool"
  ln -sfn "$PREFIX/bin/$tool" "/usr/local/bin/$tool"
done

[ -z "$gems_pid" ] || wait "$gems_pid" || echo "warning: gem install for script/api-docs failed (see /tmp/claude-setup-gems.log)"

spinel --version
echo "==> done"

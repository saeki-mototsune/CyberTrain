#!/bin/bash
# Setup script for a Claude Code cloud environment (claude.ai/code) that
# works on this repository. Paste the whole file into the environment's
# "Setup script" field; it does not read the checkout, so it works whether
# or not the repository has been cloned when it runs.
#
# The cloud VM (Ubuntu 24.04, root) already has Ruby 3.3, a C toolchain,
# make, git, curl and the SQLite headers; what it lacks is Spinel. This
# builds the pinned commit of the saeki-mototsune/spinel fork the same way
# `cybertrain setup` does (git fetch, make deps, make, make install) into the
# copy the CLI manages, ~/.cybertrain/spinel/<build>, writes the stamp the
# CLI checks, and links
# `spinel` and `spin` into ~/.cybertrain/bin and /usr/local/bin, so both
# `spin test` and `cybertrain spin test` work without touching PATH.
# It also installs the gems script/api-docs needs (as CI does).
#
# The environment caches the filesystem after a run that finishes within
# about five minutes, so later sessions start with Spinel already built.
#
# SPINEL_COMMIT and SPINEL_BUILD must equal Cybertrain::SPINEL_COMMIT and
# Cybertrain::SPINEL_BUILD (cybertrain/version.rb), and SPINEL_COMMIT the one
# in .github/workflows/ci.yml; update them here, and in the environment's
# copy of this script, when the pin moves.
set -euo pipefail

SPINEL_COMMIT="1c24fea811059781924730028fe40c8d9b87dc29"
SPINEL_BUILD="1c24fea8"
SPINEL_GIT="https://github.com/saeki-mototsune/spinel.git"
CT_HOME="${CYBERTRAIN_HOME:-$HOME/.cybertrain}"
PREFIX="$CT_HOME/spinel/$SPINEL_BUILD"
STAMP="$PREFIX/.cybertrain-complete"

# System packages: normally all present already, so apt runs only when
# one is missing.
missing=()
for pkg in build-essential git curl libsqlite3-dev libssl-dev sqlite3; do
  dpkg -s "$pkg" > /dev/null 2>&1 || missing+=("$pkg")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "==> apt-get install ${missing[*]}"
  apt-get update -qq > /dev/null
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" > /dev/null
fi

# Gems for script/api-docs, in the background while Spinel builds; a
# failure here does not stop the session from starting.
gem install --no-document yard kramdown kramdown-parser-gfm > /tmp/claude-setup-gems.log 2>&1 &
gems_pid=$!

# Spinel, unless a complete copy of the pinned build is already there
# (`spinel --version` prints its revision in parentheses, abbreviated).
installed_rev="$("$PREFIX/bin/spinel" --version 2>/dev/null | sed -n 's/^[^(]*(\([0-9a-f]\{7,\}\)).*/\1/p' || true)"
if [ -f "$STAMP" ] && [ -n "$installed_rev" ] && [ "${SPINEL_COMMIT#"$installed_rev"}" != "$SPINEL_COMMIT" ]; then
  echo "==> Spinel $SPINEL_BUILD already installed in $PREFIX"
else
  echo "==> building Spinel $SPINEL_BUILD (saeki-mototsune/spinel) into $PREFIX"
  src="$(mktemp -d)"
  log="$CT_HOME/log/spinel-$SPINEL_BUILD-build.log"
  mkdir -p "$(dirname "$log")"
  rm -f "$STAMP"
  # The build runs Ruby scripts that read UTF-8 sources; without a locale
  # Ruby reads them as ASCII and fails, hence RUBYOPT.
  {
    git init -q "$src/spinel"
    git -C "$src/spinel" fetch -q --depth 1 "$SPINEL_GIT" "$SPINEL_COMMIT"
    git -C "$src/spinel" checkout -q FETCH_HEAD
    RUBYOPT="-EUTF-8 ${RUBYOPT:-}" make -C "$src/spinel" deps
    RUBYOPT="-EUTF-8 ${RUBYOPT:-}" make -C "$src/spinel" -j"$(nproc)"
    RUBYOPT="-EUTF-8 ${RUBYOPT:-}" make -C "$src/spinel" install PREFIX="$PREFIX"
  } > "$log" 2>&1 || { echo "Spinel build failed; last lines of $log:"; tail -n 25 "$log"; exit 1; }
  rm -rf "$src"
  echo "$SPINEL_BUILD" > "$STAMP"
fi

mkdir -p "$CT_HOME/bin"
for tool in spinel spin; do
  ln -sfn "$PREFIX/bin/$tool" "$CT_HOME/bin/$tool"
  ln -sfn "$PREFIX/bin/$tool" "/usr/local/bin/$tool"
done

wait "$gems_pid" || echo "warning: gem install for script/api-docs failed (see /tmp/claude-setup-gems.log)"

spinel --version
echo "==> done"

#!/usr/bin/env ruby
# Guards Cybertrain::ClientError::CLIENT_FAULTS and ClientError.extra_faults,
# the lists of exceptions answered as a 400. They are matched by class NAME,
# not walked with `is_a?` (NOTES rules 47 and 54, and their status rows, have
# why), so a QueryInvalid subclass nobody listed would be a 500. This loads
# the framework under CRuby (cybertrain/context too, which adds
# ParameterMissing to extra_faults at load), collects every class at or below
# Cybertrain::QueryInvalid plus Cybertrain::Params::ParameterMissing, and
# fails (exit 1) when one is in neither list, or when an entry names no
# loaded class. CRuby only (needs
# ObjectSpace). Run by CI.
#
# usage: ruby script/check-client-faults
$LOAD_PATH.unshift(File.expand_path("..", __dir__))
require "cybertrain/context"
require "cybertrain/http/query"
require "cybertrain/http/multipart"
require "cybertrain/http/request"
require "cybertrain/http/client_error"

listed = Cybertrain::ClientError::CLIENT_FAULTS + Cybertrain::ClientError.extra_faults
faults = ObjectSpace.each_object(Class).select { |c| c <= Cybertrain::QueryInvalid }
faults << Cybertrain::Params::ParameterMissing
names = faults.map(&:name).compact.uniq

failed = false
(names - listed).each do |n|
  warn "#{n} is a client fault but is in neither ClientError::CLIENT_FAULTS nor extra_faults (it would answer 500)"
  failed = true
end
(listed - names).each do |n|
  warn "ClientError::CLIENT_FAULTS or extra_faults lists #{n}, which is not a loaded QueryInvalid subclass or ParameterMissing"
  failed = true
end
exit 1 if failed
puts "client faults: #{names.length} classes, all in CLIENT_FAULTS or extra_faults"

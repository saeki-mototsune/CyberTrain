#!/usr/bin/env ruby
# The commit gate: the checks a change must pass before it is committed, all
# of them fast (about a second, CRuby only, no Spinel, no gems) so they can
# run on every commit. The pre-commit hook (.githooks/pre-commit, installed
# by script/install-hooks) runs `script/gate --staged`; the Gate workflow
# (.github/workflows/gate.yml) runs `script/gate` on every push and pull
# request, so the hook and CI agree. The test suite itself (`spin test`,
# minutes of compiling) is not part of the gate: CI runs it.
#
# usage: script/gate              every tracked file, and the repository checks
#        script/gate --staged     the files staged for commit (what the hook runs)
#        script/gate FILE...      the given files
#
# Per file (text files only; *.expected snapshots and third-party files under
# site/assets/fonts/ are left alone):
#   * no trailing whitespace, a final newline, LF line endings;
#   * no merge-conflict markers;
#   * Ruby files parse (`ruby -c`); YAML files load.
# For the repository, when a file the checks read is in the set (every file,
# without --staged):
#   * Cybertrain::VERSION equals spin.toml's version, Cybertrain::SPINEL_TAG
#     equals SPINEL_TAG in .github/workflows/ci.yml, and
#     script/claude-cloud-setup's SPINEL_GIT is Cybertrain::SPINEL_REPOSITORY's
#     (that script builds the fork's latest release, so it pins no tag);
#   * script/check-reserved-names, check-client-faults and check-http-layer
#     pass, and script/ci-changes --self-test;
#   * script/bundle-locales --check passes (cybertrain/locales/bundled.rb is
#     what cybertrain/locales/*.yml give);
#   * every file cybertrain.gemspec lists exists, and the CLI loads under CRuby;
#   * playground/Dockerfile's cli-src stage copies every file the gemspec lists;
#   * the Playground image and Blog image workflows run for a pull request
#     that changes any of those files, cybertrain.gemspec or spin.toml;
#   * every test/*.rb and test/cruby/*.rb has its .expected snapshot, and every snapshot its test
#     (test/cruby/parity/, the recorded gaps of script/preview-parity, holds
#     snapshots that are not tests and is not looked into);
#   * `ruby bin/gen.rb --check` in examples/blog exits 0 under CRuby (the
#     generator writes the files the compiled one wrote).
# When docs/deploy.md, docs/deploy.en.md, docs/deploy-kamal.md or the script
# that compares them is in the set:
#   * script/check-docs-i18n passes (the English tutorial matches the Japanese).
# When a file under docs/guide/, script/check-guide-i18n or script/guide-pages*
# is in the set:
#   * script/check-guide-i18n passes (the guide translations match the English).
# When a page script/check-version-mentions reads (site/, docs/guide/,
# docs/deploy*.md, the READMEs), cybertrain/version.rb or that script is in
# the set:
#   * script/check-version-mentions passes (no page names the current release's
#     numbers).
# When a workflow, a local action (.github/workflows/, .github/actions/) or
# script/check-workflows is in the set:
#   * script/check-workflows passes (token permissions and checkout
#     credentials are stated, actions are pinned to commits and gems to
#     versions).
#
# Exit status 1 when any check fails; the failing lines are printed. To commit
# past the hook on purpose, `git commit --no-verify`; CI runs the gate anyway.
require "date"
require "open3"
require "tempfile"
require "yaml"

ROOT = File.expand_path("..", __dir__)
Dir.chdir(ROOT)

SKIP_PATH = %r{\A(site/assets/fonts/|site/api/|\.git/)}
SKIP_EXT = %w[.expected .png .jpg .jpeg .gif .ico .woff .woff2 .ttf .otf .pdf .gz .zip .sqlite3 .gem].freeze
# Third-party files kept byte for byte as fetched (their SOURCE file has
# the checksums): exempt from the trailing-whitespace check only.
# rails-i18n's ja.yml writes an empty sequence item as "- ".
VENDORED_PATH = %r{\Atest/fixtures/i18n/rails-i18n/}
# A unified diff's blank context line is a single space (` `), which patch
# reads: checked fixtures of a command's diff output keep theirs.
DIFF_FIXTURE_PATH = %r{\Atest/fixtures/[^/]+\.diff\z}
RUBY_EXT = %w[.rb .gemspec .rake].freeze
YAML_EXT = %w[.yml .yaml].freeze
# Files the repository checks read; when none of them is in the set under
# --staged (a docs-only commit, say), those checks are skipped.
REPO_INPUTS = %r{\A(cybertrain/|cybertrain\.rb\z|cybertrain\.gemspec\z|spin\.toml\z|exe/|test/|script/|\.github/workflows/ci\.yml\z|playground/Dockerfile\z)}

$failures = 0
$started = Process.clock_gettime(Process::CLOCK_MONOTONIC)

def ok(name, note = nil)
  puts "ok    #{name}#{note ? " (#{note})" : ""}"
end

def fail!(name, details = [])
  $failures += 1
  puts "FAIL  #{name}"
  Array(details).each { |line| puts "      #{line}" }
end

def skip(name, why)
  puts "skip  #{name} (#{why})"
end

def git(*args)
  out, status = Open3.capture2("git", *args)
  abort "git #{args.join(" ")} failed" unless status.success?
  out
end

# --- which files, and how to read them ---------------------------------------

mode = ARGV.first == "--staged" ? :staged : (ARGV.empty? ? :all : :given)
files =
  case mode
  when :staged then git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0")
  when :all    then git("ls-files", "-z").split("\0")
  else              ARGV.map { |f| f.delete_prefix("./") }
  end
files = files.reject { |f| f.match?(SKIP_PATH) || SKIP_EXT.include?(File.extname(f)) }
             .select { |f| mode == :staged || File.file?(f) }

# Under --staged the committed content is what is in the index, which may
# differ from the working tree (`git add -p`), so read blobs from the index.
# Bytes, whatever the locale: a UTF-8 literal must not trip a regexp under a
# runner whose locale is US-ASCII.
read = lambda do |f|
  (mode == :staged ? git("show", ":#{f}") : File.binread(f)).b
end

text_files = {}
files.each do |f|
  data = read.call(f)
  next if data.include?("\0") # binary, not ours to judge
  text_files[f] = data
end

# --- per-file checks -----------------------------------------------------------

whitespace = []
newline = []
crlf = []
conflicts = []
text_files.each do |f, data|
  data.each_line.with_index(1) do |line, n|
    body = line.chomp
    whitespace << "#{f}:#{n}" if body.match?(/[ \t]+\z/) && !f.match?(VENDORED_PATH) && !f.match?(DIFF_FIXTURE_PATH)
    crlf << "#{f}:#{n}" if line.end_with?("\r\n")
    conflicts << "#{f}:#{n}" if body.match?(/\A(<{7} |={7}\z|>{7} )/)
  end
  newline << f unless data.empty? || data.end_with?("\n")
end

whitespace.empty? ? ok("no trailing whitespace", "#{text_files.size} files") : fail!("trailing whitespace", whitespace)
newline.empty? ? ok("every file ends with a newline") : fail!("missing final newline", newline)
crlf.empty? ? ok("LF line endings") : fail!("CRLF line endings", crlf)
conflicts.empty? ? ok("no merge-conflict markers") : fail!("merge-conflict markers", conflicts)

ruby_files = text_files.select do |f, data|
  RUBY_EXT.include?(File.extname(f)) || (File.extname(f).empty? && data.lines.first.to_s.match?(/\A#!.*\bruby\b/))
end
syntax = []
# Through a file, not stdin: a script read from stdin is parsed in the
# locale's encoding, which is US-ASCII on a bare runner, and a UTF-8 literal
# then fails the check.
ruby_files.each do |f, data|
  Tempfile.create(["gate-", File.extname(f).empty? ? ".rb" : File.extname(f)]) do |tmp|
    tmp.binmode
    tmp.write(data)
    tmp.flush
    out, status = Open3.capture2e("ruby", "-c", tmp.path)
    syntax << "#{f}: #{out.lines.grep(/\S/).first.to_s.strip.sub("#{tmp.path}:", "")}" unless status.success?
  end
end
if ruby_files.empty?
  skip("ruby syntax", "no Ruby files in the set")
elsif syntax.empty?
  ok("ruby syntax", "#{ruby_files.size} files")
else
  fail!("ruby syntax", syntax)
end

yaml_files = text_files.select { |f, _| YAML_EXT.include?(File.extname(f)) }
bad_yaml = []
yaml_files.each do |f, data|
  YAML.safe_load(data, aliases: true, permitted_classes: [Symbol, Date, Time])
rescue Psych::Exception => e
  bad_yaml << "#{f}: #{e.message.lines.first.strip}"
end
if yaml_files.empty?
  skip("yaml", "no YAML files in the set")
elsif bad_yaml.empty?
  ok("yaml loads", "#{yaml_files.size} files")
else
  fail!("yaml", bad_yaml)
end

# --- the deployment tutorial and its translations --------------------------------

# docs/deploy.md is translated into deploy.en.md (part 8: deploy-kamal.md);
# a change to one that misses the other is caught here, where it is cheap.
DOCS_I18N = %r{\A(docs/deploy(\.en|-kamal)?\.md|script/check-docs-i18n)\z}
if mode != :all && files.none? { |f| f.match?(DOCS_I18N) }
  skip("deploy tutorial translations", "no docs/deploy*.md in the set")
else
  out, status = Open3.capture2e("ruby", "script/check-docs-i18n")
  status.success? ? ok("deploy tutorial translations match", "script/check-docs-i18n") : fail!("deploy tutorial translations", out.lines.map(&:chomp))
end

# --- the guide pages and their translations ----------------------------------------

# docs/guide/*.md is translated into docs/guide/{ja,zh,ru,fr}/; script/check-guide-i18n
# compares them.
GUIDE_I18N = %r{\A(docs/guide/|script/check-guide-i18n\z|script/guide-pages)}
if mode != :all && files.none? { |f| f.match?(GUIDE_I18N) }
  skip("guide translations", "no docs/guide file in the set")
else
  out, status = Open3.capture2e("ruby", "script/check-guide-i18n")
  status.success? ? ok("guide translations match", "script/check-guide-i18n") : fail!("guide translations", out.lines.map(&:chomp))
end

# --- release numbers in the pages ------------------------------------------------

# The site, the guides, the deployment tutorial and the READMEs describe the
# current release without naming its numbers, which move with every release.
VERSION_MENTIONS = %r{\A(site/(?!api/).*\.html|docs/guide/.*\.md|docs/deploy(\.en|-kamal)?\.md|(playground/)?README\.md|cybertrain/version\.rb|script/check-version-mentions)\z}
if mode != :all && files.none? { |f| f.match?(VERSION_MENTIONS) }
  skip("release numbers in the pages", "no page, cybertrain/version.rb or script/check-version-mentions in the set")
else
  out, status = Open3.capture2e("ruby", "script/check-version-mentions")
  status.success? ? ok("no page names the release numbers", "script/check-version-mentions") : fail!("release numbers in the pages", out.lines.map(&:chomp))
end

# --- the workflows' own rules -----------------------------------------------------

# What YAML that loads can still get wrong without anyone noticing: a token
# with the repository's default permissions, a checkout that leaves its
# credentials behind, an action named by a tag that can move, a gem
# installed at whatever version is newest that day.
WORKFLOW_RULES = %r{\A(\.github/(workflows|actions)/|script/check-workflows\z)}
if mode != :all && files.none? { |f| f.match?(WORKFLOW_RULES) }
  skip("workflow rules", "no workflow or local action in the set")
else
  out, status = Open3.capture2e("ruby", "script/check-workflows")
  status.success? ? ok("workflow rules", "script/check-workflows") : fail!("workflow rules", out.lines.map(&:chomp))
end

# --- repository checks -----------------------------------------------------------

if mode == :staged && files.none? { |f| f.match?(REPO_INPUTS) }
  skip("repository checks", "nothing staged under cybertrain/, exe/, test/, script/, the pins or playground/Dockerfile")
else
  version_rb = "cybertrain/version.rb"
  version = File.read(version_rb)[/VERSION = "([^"]+)"/, 1]
  spinel_tag = File.read(version_rb)[/SPINEL_TAG = "([^"]+)"/, 1]
  pins = []
  spin_version = File.read("spin.toml")[/^version = "([^"]+)"/, 1]
  pins << "spin.toml version #{spin_version.inspect} != Cybertrain::VERSION #{version.inspect}" unless spin_version == version
  ci_tag = File.read(".github/workflows/ci.yml")[/^\s*SPINEL_TAG: "([^"]+)"/, 1]
  pins << ".github/workflows/ci.yml SPINEL_TAG #{ci_tag.inspect} != Cybertrain::SPINEL_TAG #{spinel_tag.inspect}" unless ci_tag == spinel_tag
  spinel_repo = File.read(version_rb)[/SPINEL_REPOSITORY = "([^"]+)"/, 1]
  setup_git = File.read("script/claude-cloud-setup")[/^SPINEL_GIT="([^"]+)"/, 1]
  pins << "script/claude-cloud-setup SPINEL_GIT #{setup_git.inspect} != Cybertrain::SPINEL_REPOSITORY + \".git\" #{"#{spinel_repo}.git".inspect}" unless setup_git == "#{spinel_repo}.git"
  pins.empty? ? ok("version and Spinel tag pinned in one place", "#{version}, spinel #{spinel_tag}") : fail!("version pins", pins)

  %w[check-reserved-names check-client-faults check-http-layer].each do |script|
    out, status = Open3.capture2e("ruby", "script/#{script}")
    status.success? ? ok("script/#{script}") : fail!("script/#{script}", out.lines.map(&:chomp))
  end

  # Which CI jobs a change needs (ci.yml's `changes` job): the rule's own cases.
  out, status = Open3.capture2e("sh", "script/ci-changes", "--self-test")
  status.success? ? ok("script/ci-changes --self-test") : fail!("script/ci-changes --self-test", out.lines.map(&:chomp))

  out, status = Open3.capture2e("ruby", "script/bundle-locales", "--check")
  status.success? ? ok("bundled dictionaries fresh", "script/bundle-locales --check") : fail!("script/bundle-locales --check", out.lines.map(&:chomp))

  spec_out, spec_status = Open3.capture2e("ruby", "-e", <<~'RB')
    spec = Gem::Specification.load("cybertrain.gemspec") or abort "cybertrain.gemspec does not load"
    missing = spec.files.reject { |f| File.file?(f) }
    abort "cybertrain.gemspec lists files that do not exist: #{missing.join(", ")}" unless missing.empty?
    $LOAD_PATH.unshift(".")
    require "cybertrain/cli"
    # What the CLI loaded from this tree must all be in the gem: an
    # installed gem has only spec.files, and a require of anything else is
    # a LoadError there that loading from the source tree never shows.
    root = File.expand_path(".") + "/"
    loaded = $LOADED_FEATURES.select { |f| f.start_with?(root) }.map { |f| f.delete_prefix(root) }
    unlisted = loaded - spec.files
    abort "the CLI requires files cybertrain.gemspec does not list: #{unlisted.sort.join(", ")}" unless unlisted.empty?
    print spec.files.size
  RB
  spec_status.success? ? ok("gem file list and CLI load under CRuby", "#{spec_out} files") : fail!("gemspec / CLI", spec_out.lines.map(&:chomp))

  # The playground image builds the gem from a scratch stage (cli-src) that
  # copies spec.files by hand, so that a framework-only change keeps the gem
  # layer cached. A file added to spec.files and not to that stage passes
  # every check above and then fails `gem build` in the Playground image job
  # ("... are not files"), twenty minutes later. Read the stage's COPY lines
  # (a source ending in "/" or naming a directory stands for the files under
  # it) and name every gemspec file none of them copies.
  list_out, list_status = Open3.capture2e("ruby", "-e", 'puts Gem::Specification.load("cybertrain.gemspec").files')
  dockerfile = "playground/Dockerfile"
  if !list_status.success?
    skip("playground gem stage copies spec.files", "cybertrain.gemspec does not load (reported above)")
  elsif !File.file?(dockerfile)
    fail!("playground gem stage", ["#{dockerfile} is missing"])
  else
    stage = []
    inside = false
    File.read(dockerfile).gsub(/\\\n/, " ").each_line do |line|
      words = line.split
      next if words.empty?

      if words[0].casecmp?("FROM")
        inside = words.last == "cli-src"
      elsif inside && words[0].casecmp?("COPY")
        args = words[1..].reject { |w| w.start_with?("--") }
        stage.concat(args[0..-2])
      end
    end
    if stage.empty?
      fail!("playground gem stage", ["#{dockerfile} has no COPY in a `FROM ... AS cli-src` stage"])
    else
      copied = stage.flat_map do |src|
        path = src.delete_suffix("/")
        File.directory?(path) ? Dir.glob("#{path}/**/*").select { |f| File.file?(f) } : [path]
      end
      missing = list_out.lines.map(&:chomp) - copied
      if missing.empty?
        ok("playground gem stage copies spec.files", "#{stage.size} COPY sources")
      else
        fail!("playground gem stage", missing.map { |f| "#{dockerfile} (cli-src) does not copy #{f}, which cybertrain.gemspec lists" })
      end
    end
  end

  # Both image builds run the CLI (`cybertrain setup`, and `doctor` or
  # `build`) on their own package lists, which no other job does, so a pull
  # request that changes the CLI or the pins must run them. Their
  # `pull_request: paths:` name those files by hand: name every gemspec file
  # (but the README) and pin file that one of them would not start for.
  image_inputs = list_status.success? ? list_out.lines.map(&:chomp) - ["README.md"] + %w[cybertrain.gemspec spin.toml] : []
  uncovered = %w[playground-image blog-image].flat_map do |name|
    workflow = ".github/workflows/#{name}.yml"
    paths = YAML.load_file(workflow).then { |y| y["on"] || y[true] }.dig("pull_request", "paths") || []
    image_inputs.reject do |file|
      # GitHub's rule: the last pattern that matches decides; `!` excludes.
      paths.reduce(false) do |run, pattern|
        glob = Regexp.escape(pattern.delete_prefix("!")).gsub("\\*\\*", ".*").gsub("\\*", "[^/]*")
        file.match?(/\A#{glob}\z/) ? !pattern.start_with?("!") : run
      end
    end.map { |file| "#{workflow} does not run for a pull request that changes #{file}" }
  end
  if image_inputs.empty?
    skip("image workflows run for the CLI and the pins", "cybertrain.gemspec does not load (reported above)")
  else
    uncovered.empty? ? ok("image workflows run for the CLI and the pins", "#{image_inputs.size} files") : fail!("image workflow paths", uncovered)
  end

  tests = Dir["test/*.rb", "test/cruby/*.rb"].map { |f| f.delete_suffix(".rb") }
  snaps = Dir["test/*.rb.expected", "test/cruby/*.rb.expected"].map { |f| f.delete_suffix(".rb.expected") }
  orphans = (tests - snaps).map { |t| "#{t}.rb has no #{File.basename(t)}.rb.expected (#{t.start_with?("test/cruby/") ? "script/test-cruby --regen" : "script/regen-snapshot"} #{t}.rb)" } +
            (snaps - tests).map { |s| "#{s}.rb.expected has no #{File.basename(s)}.rb" }
  orphans.empty? ? ok("every test has its snapshot", "#{tests.size} tests") : fail!("test snapshots", orphans)

  # The generator runs under CRuby as it does compiled: --check writes
  # nothing and exits 1 when a generated file would change.
  gen_out, gen_status = Open3.capture2e("ruby", "-E", "UTF-8", "-I", ROOT, "-I", ".", "bin/gen.rb", "--check", chdir: File.join(ROOT, "examples/blog"))
  gen_status.success? ? ok("gen under CRuby leaves examples/blog unchanged") : fail!("gen under CRuby changes examples/blog", gen_out.lines.first(10).map(&:chomp))
end

elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - $started
if $failures.zero?
  puts format("gate: passed in %.1fs", elapsed)
else
  puts format("gate: %d check%s failed in %.1fs", $failures, $failures == 1 ? "" : "s", elapsed)
  puts "      (to commit anyway: git commit --no-verify; CI runs the gate regardless)"
  exit 1
end

#!/bin/sh
# Which CI jobs a change needs: reads the changed paths, one a line, on
# stdin and prints `framework=true|false`, `cruby_preview=true|false`,
# `preview_e2e=true|false`, `macos=true|false` and `setup_action=true|false`. The `changes` job of .github/workflows/ci.yml
# runs it. The jobs that compile (the framework tests, the end-to-end jobs,
# the setup-cybertrain action's) run only on `framework=true`; the
# cruby-preview job only on `cruby_preview=true`; the preview-e2e job only
# on `preview_e2e=true`. The api-docs job runs on every CI run and is not
# decided here.
#
# `on.paths` in ci.yml decides whether the workflow starts at all; it cannot
# tell the jobs apart, so its rule is repeated here, with one more case: the
# paths only the API reference reads (script/api-docs, .yardopts) start the
# workflow and need no compiling.
#
#   false  docs/api/**, script/api-docs, .yardopts (the API reference only)
#   true   .github/workflows/ci.yml, script/test-shard, script/ci-changes,
#          script/auth-e2e, script/test-command-e2e, script/generators-e2e,
#          script/spinel_http_path.rb (test/gen_jobs.rb runs it)
#   false  what on.paths leaves out: site/**, **.md, script/**, .githooks/**,
#          .github/workflows/** (in a change that started the workflow
#          through another file)
#   true   everything else
#
# cruby_preview (the framework's tests and the generator under CRuby, no
# Spinel): true for cybertrain/**, cybertrain.rb, test/**, spin.toml and
# spin.lock (spinel-http's pin), script/spinel_http_path.rb (which finds
# it), script/preview-parity, script/test-cruby, .github/workflows/ci.yml,
# script/ci-changes and .github/actions/setup-cybertrain/** (whose lock
# step test/cruby/setup_action_lock.rb runs) (and a quoted path); false for
# everything else. For the two scripts it is the only job that runs:
# `framework` stays false.
#
# preview_e2e (script/preview-e2e: `cybertrain server` on a copy of
# examples/blog, built with Spinel): true for what that run reads, which
# is the framework (cybertrain/**, cybertrain.rb), the CLI it starts
# (exe/**), examples/blog/**, spin.toml and spin.lock (the packages), the script itself,
# the toolchain's action (.github/actions/setup-spinel/**), ci.yml and
# script/ci-changes (and a quoted path); false for everything else, the
# framework's tests (test/**) included. For script/preview-e2e alone it is
# the only job that runs.
#
# macos (the macOS legs of the test, cruby-preview and setup-cybertrain
# jobs) and setup_action (the setup-cybertrain job) narrow a pull request
# only: the `changes` job sets both to true on every other event (main, a
# release, a merge group) and when the pull request has the label
# `ci:macos` (macos alone), so main still runs everything after the merge
# (docs/design.md, D34). macOS runners are the scarcest (five at a time
# for the account), so a pull request runs them only where the two systems
# have been seen to differ: the CLI and its toolchain (processes, file
# locks, OpenSSL linking), the development server and the CRuby preview
# (/proc, `ps`, `.dylib`), sockets and the server roles, the pins, the
# actions and the scripts the macOS job runs, and the tests of those
# (a `.darwin` snapshot anywhere). setup_action is what the job reads:
# the action, `cybertrain new` and its templates (the CLI and the
# generator), the pins and the gem's files; a change elsewhere in the
# framework compiles in the `test` job's applications already.
#
#   macos        cybertrain/cli/**, cybertrain/cli.rb, exe/**,
#                cybertrain/shell.rb, cybertrain/version.rb,
#                cybertrain/dev/**, cybertrain/dev.rb, cybertrain/preview/**,
#                cybertrain/preview.rb, cybertrain/http/**, cybertrain/net/**,
#                cybertrain/roles/**, cybertrain/runtime.rb, spin.toml,
#                spin.lock, cybertrain.gemspec, test/cli_*, test/server*, test/dev_*,
#                test/cruby/**, test/db_sqlite*, test/job_threads*, *.darwin,
#                .github/actions/**, ci.yml, script/ci-changes,
#                script/test-cruby, script/auth-e2e, script/test-command-e2e,
#                script/generators-e2e
#   setup_action .github/actions/setup-cybertrain/**, cybertrain/cli/**,
#                cybertrain/cli.rb, exe/**, cybertrain/generator/**,
#                cybertrain/generator.rb, cybertrain/version.rb,
#                cybertrain/app_name.rb, cybertrain/ident.rb,
#                cybertrain/shell.rb, spin.toml, spin.lock, cybertrain.gemspec, ci.yml,
#                script/ci-changes
#
# One path that says true is enough. A path this file does not know says
# true, and so does one git printed quoted (an unusual character in the
# name): the jobs run when in doubt.
#
# usage: git diff --name-only BASE HEAD | script/ci-changes
#        script/ci-changes --self-test    check the rule against known cases

decide() {
  framework=false
  cruby=false
  e2e=false
  macos=false
  setup_action=false
  while IFS= read -r path; do
    case "$path" in
      cybertrain/* | cybertrain.rb | test/* | spin.toml | spin.lock | script/spinel_http_path.rb | script/preview-parity | script/test-cruby | .github/workflows/ci.yml | script/ci-changes | .github/actions/setup-cybertrain/* | \"*) cruby=true ;;
    esac
    case "$path" in
      cybertrain/* | cybertrain.rb | exe/* | examples/blog/* | spin.toml | spin.lock | script/preview-e2e | .github/actions/setup-spinel/* | .github/workflows/ci.yml | script/ci-changes | \"*) e2e=true ;;
    esac
    case "$path" in
      cybertrain/cli/* | cybertrain/cli.rb | exe/* | cybertrain/shell.rb | cybertrain/version.rb | \
        cybertrain/dev/* | cybertrain/dev.rb | cybertrain/preview/* | cybertrain/preview.rb | \
        cybertrain/http/* | cybertrain/net/* | cybertrain/roles/* | cybertrain/runtime.rb | \
        spin.toml | spin.lock | cybertrain.gemspec | test/cli_* | test/server* | test/dev_* | test/cruby/* | \
        test/db_sqlite* | test/job_threads* | *.darwin | .github/actions/* | .github/workflows/ci.yml | \
        script/ci-changes | script/test-cruby | script/auth-e2e | script/test-command-e2e | \
        script/generators-e2e | \"*) macos=true ;;
    esac
    case "$path" in
      .github/actions/setup-cybertrain/* | cybertrain/cli/* | cybertrain/cli.rb | exe/* | \
        cybertrain/generator/* | cybertrain/generator.rb | cybertrain/version.rb | \
        cybertrain/app_name.rb | cybertrain/ident.rb | cybertrain/shell.rb | spin.toml | spin.lock | \
        cybertrain.gemspec | .github/workflows/ci.yml | script/ci-changes | \"*) setup_action=true ;;
    esac
    case "$path" in
      "") ;;
      docs/api/* | script/api-docs | .yardopts) ;;
      .github/workflows/ci.yml | script/test-shard | script/ci-changes | script/auth-e2e | script/test-command-e2e | script/generators-e2e | script/spinel_http_path.rb) framework=true ;;
      site/* | *.md | script/* | .githooks/* | .github/workflows/*) ;;
      *) framework=true ;;
    esac
  done
  echo "framework=$framework"
  echo "cruby_preview=$cruby"
  echo "preview_e2e=$e2e"
  echo "macos=$macos"
  echo "setup_action=$setup_action"
}

# expect_key KEY WANT PATH...: decide on the paths and compare the output
# line KEY with KEY=WANT. expect WANT PATH... does it for `framework`,
# expect_cruby for `cruby_preview`, expect_e2e for `preview_e2e`.
expect_key() {
  key=$1
  want="$key=$2"
  shift 2
  got=$(printf '%s\n' "$@" | decide | grep "^$key=")
  if [ "$got" = "$want" ]; then return 0; fi
  echo "script/ci-changes: $* gave $got, expected $want" >&2
  failed=1
}
expect() { expect_key framework "$@"; }
expect_cruby() { expect_key cruby_preview "$@"; }
expect_e2e() { expect_key preview_e2e "$@"; }
expect_macos() { expect_key macos "$@"; }
expect_setup() { expect_key setup_action "$@"; }

if [ "${1:-}" = "--self-test" ]; then
  failed=0
  # The API reference alone: no compiling.
  expect false docs/api/README.md
  expect false docs/api/yard_setup.rb docs/api/stubs/models.rb docs/api/templates/default/layout/html/setup.rb
  expect false script/api-docs .yardopts
  # With a page or a script on.paths leaves out, still none.
  expect false docs/api/README.md site/index.html README.md script/gate .githooks/pre-commit .github/workflows/pages.yml
  # Code, tests, the example, the actions, the pins: the tests run.
  expect true cybertrain/router.rb
  expect true docs/api/README.md cybertrain/router.rb
  expect true test/router.rb.expected
  expect true examples/blog/app/models/post.rb
  expect true .github/actions/setup-cybertrain/action.yml
  expect true .github/actions/setup-spinel/action.yml
  expect true .github/workflows/ci.yml
  expect true script/test-shard
  expect true script/ci-changes
  expect true script/auth-e2e
  expect true script/test-command-e2e
  expect true script/generators-e2e
  expect true test/fixtures/test_app.expected/all.out
  expect true spin.toml
  expect true spin.lock
  expect true script/spinel_http_path.rb
  expect true cybertrain.gemspec
  expect true playground/Dockerfile
  expect true docs/guide/images/a.png
  # Not the API reference's: only docs/api/ is.
  expect true docs/apiary.rb
  # A quoted path is not recognised.
  expect true '"docs/api/caf\303\251.rb"'
  # The CRuby preview job: the framework, its tests and its two scripts.
  expect_cruby true cybertrain/router.rb
  expect_cruby true cybertrain/preview/ffi.rb
  expect_cruby true test/cruby/parity-gaps.txt
  expect_cruby true script/preview-parity
  expect_cruby true script/test-cruby
  expect_cruby true spin.lock
  expect_cruby true script/spinel_http_path.rb
  expect_cruby true .github/workflows/ci.yml
  expect_cruby true .github/actions/setup-cybertrain/action.yml
  expect_cruby true '"docs/api/caf\303\251.rb"'
  expect_cruby false docs/api/README.md site/index.html README.md script/gate script/api-docs examples/blog/app/models/post.rb
  expect_cruby true docs/api/README.md test/router.rb
  # The two scripts start the workflow and need no compiling.
  expect false script/preview-parity script/test-cruby
  # The preview end to end: what script/preview-e2e reads.
  expect_e2e true cybertrain/preview/ffi_library.rb
  expect_e2e true cybertrain/cli/dev_server/processes.rb
  expect_e2e true cybertrain/dev/watcher.rb
  expect_e2e true cybertrain.rb
  expect_e2e true exe/cybertrain
  expect_e2e true examples/blog/app/models/article.rb
  expect_e2e true spin.toml
  expect_e2e true spin.lock
  expect_e2e true script/preview-e2e
  expect_e2e true .github/actions/setup-spinel/action.yml
  expect_e2e true .github/workflows/ci.yml
  expect_e2e true script/ci-changes
  expect_e2e true '"docs/api/caf\303\251.rb"'
  expect_e2e false test/router.rb test/cruby/preview_ffi.rb script/preview-parity script/test-cruby
  expect_e2e false docs/api/README.md site/index.html README.md script/gate playground/Dockerfile .github/actions/setup-cybertrain/action.yml
  # The script starts the workflow and needs no compiling, nor the CRuby
  # preview job.
  expect false script/preview-e2e
  expect_cruby false script/preview-e2e
  # macOS on a pull request: where the systems differ, not the whole framework.
  expect_macos true cybertrain/cli/toolchain.rb
  expect_macos true cybertrain/cli.rb
  expect_macos true exe/cybertrain
  expect_macos true cybertrain/version.rb
  expect_macos true cybertrain/dev/watcher.rb
  expect_macos true cybertrain/preview/ffi.rb
  expect_macos true cybertrain/http/server.rb
  expect_macos true cybertrain/roles/server.rb
  expect_macos true test/cli_toolchain.rb
  expect_macos true test/server.rb.expected
  expect_macos true test/cruby/dev_server.rb.expected.darwin
  expect_macos true test/job_threads.rb
  expect_macos true spin.toml
  expect_macos true spin.lock
  expect_macos true .github/actions/setup-spinel/action.yml
  expect_macos true .github/workflows/ci.yml
  expect_macos true script/auth-e2e
  expect_macos true '"cybertrain/caf\303\251.rb"'
  expect_macos true cybertrain/router.rb cybertrain/cli/new_app.rb
  expect_macos false cybertrain/router.rb
  expect_macos false cybertrain/model.rb test/model.rb test/model.rb.expected
  expect_macos false examples/blog/app/models/article.rb
  expect_macos false cybertrain/generator/scaffold.rb
  # The CRuby preview's macOS leg runs script/test-cruby.
  expect_macos true script/test-cruby
  expect_macos false docs/api/README.md site/index.html README.md
  # The setup-cybertrain job: the action and what `cybertrain new` writes.
  expect_setup true .github/actions/setup-cybertrain/action.yml
  expect_setup true cybertrain/cli/templates.rb
  expect_setup true cybertrain/generator/scaffold.rb
  expect_setup true cybertrain/version.rb
  expect_setup true spin.toml
  expect_setup true spin.lock
  expect_setup true .github/workflows/ci.yml
  expect_setup true '"cybertrain/caf\303\251.rb"'
  expect_setup false cybertrain/router.rb test/router.rb
  expect_setup false .github/actions/setup-spinel/action.yml
  expect_setup false examples/blog/app/models/article.rb
  expect_setup false docs/api/README.md
  if [ "$failed" = 0 ]; then echo "script/ci-changes: self-test passed"; fi
  exit "$failed"
fi

if [ $# -ne 0 ]; then
  echo "usage: git diff --name-only BASE HEAD | script/ci-changes" >&2
  echo "       script/ci-changes --self-test" >&2
  exit 2
fi

decide

    <nav class="nav-links" aria-label="<%= w(:primary) %>">
      <ul>
        <li class="nav-wide-only"><a href="<%= home %>index.html#how-it-works"><%= w(:how) %></a></li>
        <li><a href="<%= home %>tutorial.html"<%= current("tutorial") %>><%= w(:tutorial) %></a></li>
        <li class="nav-wide-only"><a href="<%= home %>deploy.html"><%= w(:deploy) %></a></li>
        <li class="nav-wide-only"><a href="<%= home %>guide/index.html"<%= current("guides") %>><%= w(:guides) %></a></li>
        <li><a href="<%= home %>playground.html"><%= w(:playground) %></a></li>
        <li class="nav-roomy-only"><a href="<%= up %>api/index.html">API</a></li>
        <li><a href="https://github.com/saeki-mototsune/CyberTrain" rel="noopener">GitHub<span class="ext" aria-hidden="true">&#8599;</span></a></li>
        <li><details class="lang-menu">
          <summary aria-label="<%= w(:lang_label) %>"><%= lang.upcase %></summary>
          <ul>
<% langs.each do |l| -%>
            <%= l.item %>
<% end -%>
          </ul>
        </details></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">

<div class="wrap">
  <header class="doc-hero">
    <p class="crumb"><a href="<%= home %>index.html">CyberTrain</a><% crumbs.each do |text, href| %><span aria-hidden="true"> / </span><%= href ? %(<a href="#{href}">#{text}</a>) : "<span>#{text}</span>" %><% end %></p>
    <h1 id="<%= page.h1_id %>"><%= page.h1 %></h1>
<% if page.intro_html -%>
    <p class="doc-intro"><%= page.intro_html %></p>
<% end -%>
<% unless meta.empty? -%>
    <dl class="doc-meta">
<% meta.each do |term, text| -%>
      <div><dt><%= term %></dt><dd><%= text %></dd></div>
<% end -%>
    </dl>
<% end -%>
  </header>
</div>

<div class="wrap<%= " doc" unless page.toc.empty? %>">
<% unless page.toc.empty? -%>
  <nav class="toc" aria-label="<%= toc_label %>">
    <details class="toc-d" open>
      <summary class="toc-sum"><span class="toc-title"><%= toc_title %></span><span class="toc-count" data-count aria-hidden="true"></span><span class="toc-chev" aria-hidden="true"></span></summary>
      <div class="toc-bar" aria-hidden="true"><span data-bar></span></div>
    <ol>
<% page.toc.each do |e| -%>
      <li<%= ' class="toc-x"' if e.extra %>><a href="#<%= e.id %>"><span class="toc-n"><%= toc_num(e.num) %></span><%= e.title_html %></a></li>
<% end -%>
    </ol>
    </details>
  </nav>

<% end -%>
  <article class="doc-body">

<%= page.sections_html.chomp %>

  </article>
</div>

</main>

#!/usr/bin/env ruby
# Builds the site's guide pages from the Markdown in docs/guide/ (English) and
# docs/guide/<lang>/ (translations): the tutorial at tutorial.html and
# <lang>/tutorial.html, every other guide at guide/<name>.html and
# <lang>/guide/<name>.html, each in one page shell
# (script/guide-pages.d/layout.html.erb, which reproduces the hand-written
# site/tutorial.html this replaced: `git show 2a73b58:site/tutorial.html`),
# plus api/file.<name>.html redirects from the old YARD URLs. The Pages
# workflow runs it after script/api-docs; none of its output is committed
# (.gitignore). It fails, listing every problem and writing nothing, on a
# link to a missing source, anchor, repository path or site/ page, a source
# without exactly one "# " title, a heading id used twice, an unclosed code
# fence, a malformed step comment, a code fence language Rouge does not
# know, a relative image, an unknown front matter key, or a front matter
# path other than tutorial.html or guide/<name>.html. Needs the kramdown,
# kramdown-parser-gfm and rouge gems; the conventions are listed in
# script/guide-pages.d/lib/render.rb.
#
# usage: script/guide-pages [--out DIR]   (default: site/; exit status 1 and
#                                         the problems when any)

require_relative "guide-pages.d/lib/build"

ROOT = File.expand_path("..", __dir__)

out = File.join(ROOT, "site")
args = ARGV.dup
until args.empty?
  arg = args.shift
  abort "usage: script/guide-pages [--out DIR]" unless arg == "--out" && args.first
  out = File.expand_path(args.shift)
end

errors = GuidePages::Build.run(root: ROOT, out: out)
if errors.empty?
  puts "docs/guide: pages written to #{out}"
else
  puts errors
  exit 1
end

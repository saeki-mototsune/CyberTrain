#!/bin/sh
# A MySQL 8.0 server in Docker for the MySQL adapter's tests: starts it (or
# reuses the one already running), waits until it answers over TCP, and
# prints the URL the tests read:
#
#   export "$(script/mysql-dev)"   # sets CYBERTRAIN_TEST_MYSQL_URL
#   script/test-mysql              # test/mysql/*.rb against it
#   script/mysql-dev stop          # removes the container
#
# The server runs with --default-time-zone=+09:00 on purpose: datetimes must
# round-trip in UTC on a server whose zone is not UTC (the plan's Review
# Focus 4, test/mysql/connection.rb's datetime_utc_on_non_utc_server). A
# container that is reused is checked for that zone and for the pinned
# image, so a server started some other way, or from an earlier pin, is not
# mistaken for this one. Its character set and
# collation default to utf8mb4 / utf8mb4_0900_bin, the adapter's. Besides
# cybertrain_test (the URL's), it holds the databases cybertrain_tdb_test and
# cybertrain_tdb, which test/mysql/test_database.rb uses, and
# cybertrain_blog_test, which `script/test-mysql --blog` runs examples/blog's
# tests on.
#
# The image is pinned to one release (the same tag as the mysql-tests job of
# .github/workflows/ci.yml), so a new 8.0 release changes nothing until the
# pin moves. MySQL 8.0's default authentication plugin stays
# caching_sha2_password; root@'%' is switched to mysql_native_password,
# because the URL is ssl_mode=disabled (the server is on loopback) and
# caching_sha2_password's full authentication needs TLS
# (cybertrain/db/mysql/auth.rb).
#
# Development only: the password below is not a secret, so the port is
# published on 127.0.0.1 alone (-p 127.0.0.1:33306:3306), never on the
# host's other interfaces. Only the container named cybertrain-mysql is
# ever started, stopped or removed. Running it again is harmless
# (idempotent).
#
# usage: script/mysql-dev [start|stop]
set -eu

name=cybertrain-mysql
image=mysql:8.0.46
password=cybertrain
url="mysql://root:${password}@127.0.0.1:33306/cybertrain_test?ssl_mode=disabled"

case "${1:-start}" in
  start) ;;
  stop)
    docker rm -f "$name" >/dev/null 2>&1 || true
    exit 0
    ;;
  *)
    echo "usage: script/mysql-dev [start|stop]" >&2
    exit 2
    ;;
esac

reused=false
if [ -n "$(docker ps -q --filter "name=^${name}\$")" ]; then
  reused=true
elif [ -n "$(docker ps -aq --filter "name=^${name}\$")" ]; then
  docker start "$name" >/dev/null
  reused=true
else
  docker run -d --name "$name" -e MYSQL_ROOT_PASSWORD="$password" -e MYSQL_DATABASE=cybertrain_test \
    -p 127.0.0.1:33306:3306 "$image" --default-time-zone=+09:00 \
    --character-set-server=utf8mb4 --collation-server=utf8mb4_0900_bin >/dev/null
fi

# Over TCP, not the socket: the image's first-start initialisation runs a
# temporary server without networking, which must not count as ready.
tries=0
until docker exec "$name" mysqladmin ping -h 127.0.0.1 -uroot -p"$password" --silent >/dev/null 2>&1; do
  tries=$((tries + 1))
  if [ "$tries" -ge 180 ]; then
    echo "script/mysql-dev: $name did not answer within 180 s (docker logs $name)" >&2
    exit 1
  fi
  sleep 1
done

if [ "$reused" = true ]; then
  # A container made from an earlier pin is not reused silently: local runs
  # and CI would be on different servers until someone removed it.
  used=$(docker inspect -f '{{.Config.Image}}' "$name")
  if [ "$used" != "$image" ]; then
    echo "script/mysql-dev: the running $name is from the image '${used}', not $image; remove it (script/mysql-dev stop) and run this again" >&2
    exit 1
  fi
  zone=$(docker exec "$name" mysql -h 127.0.0.1 -uroot -p"$password" -N -B -e "SELECT @@global.time_zone" 2>/dev/null || true)
  if [ "$zone" != "+09:00" ]; then
    echo "script/mysql-dev: the running $name has time zone '${zone}', not +09:00; remove it (script/mysql-dev stop) and run this again" >&2
    exit 1
  fi
fi

docker exec "$name" mysql -h 127.0.0.1 -uroot -p"$password" -e \
  "ALTER USER 'root'@'%' IDENTIFIED WITH mysql_native_password BY '$password';" 2>/dev/null

# The two databases test/mysql/test_database.rb uses besides cybertrain_test
# (no test program creates them; test/mysql/db_cli.rb creates and drops a
# database of its own, cybertrain_cli_test, through `db create` and `db
# drop`): cybertrain_tdb_test, which it needs empty but for its own tables,
# and cybertrain_tdb, a name without _test, which it only sees refused. And examples/blog's
# (`script/test-mysql --blog`), which its test bundle empties.
docker exec "$name" mysql -h 127.0.0.1 -uroot -p"$password" -e \
  "CREATE DATABASE IF NOT EXISTS cybertrain_tdb_test; CREATE DATABASE IF NOT EXISTS cybertrain_tdb;
   CREATE DATABASE IF NOT EXISTS cybertrain_blog_test;" 2>/dev/null

echo "CYBERTRAIN_TEST_MYSQL_URL=$url"

#!/usr/bin/env bash
# The legs of the end-to-end suite: the one list that the `e2e` jobs of
# .github/workflows/ci.yml and .github/workflows/spinel-candidate.yml run,
# one runner a leg (each reads it with `--json` into its matrix and runs a
# leg with `run`), and that a contributor can run one leg of by name.
#
#   leg                         CLI       runs
LEGS="
auth-signup                   gem       script/auth-e2e signup
auth-invite                   checkout  script/auth-e2e invite
auth-confirmable              checkout  script/auth-e2e confirmable
auth-upgrade04-patch          checkout  script/auth-e2e upgrade04-patch
auth-upgrade04-force          checkout  script/auth-e2e upgrade04-force
auth-upgrade04-confirmable    checkout  script/auth-e2e upgrade04-confirmable
generators                    checkout  script/generators-e2e
test-command                  checkout  script/test-command-e2e
blog                          gem       blog
"
#
# CLI is the `cybertrain` a leg runs (CYBERTRAIN_E2E_CLI, script/e2e.d/lib.sh):
# `gem`, the one on PATH, which CI's setup-spinel builds from this checkout
# and installs, so the gem's file list is used where users meet it; or
# `checkout`, `ruby -I. exe/cybertrain`. An exported CYBERTRAIN_E2E_CLI
# overrides it (`CYBERTRAIN_E2E_CLI=checkout script/e2e-legs run blog` on a
# machine without the gem).
#
# `blog` is examples/blog in this checkout, not a copy: gen/ fresh (`spin run
# gen` changes nothing, `git status` rather than `git diff`, so a file gen
# writes for the first time counts), every test of the blog in one program
# (`cybertrain test`), then gen --check, which proves the test run wrote
# nothing gen would not. It builds in examples/blog/build/, so do not run
# two at once.
#
# A workflow's own steps beside a leg (ci.yml's git dependency after
# test-command) stay in that workflow.
#
# usage: script/e2e-legs                 the legs, one a line: leg, CLI, what it runs
#        script/e2e-legs --json          the leg names as a JSON array (a matrix)
#        script/e2e-legs run LEG         run one leg
set -euo pipefail

# shellcheck source=script/e2e.d/lib.sh
. "$(dirname "$0")/e2e.d/lib.sh"
e2e_init e2e-legs

legs() {
  printf '%s\n' "$LEGS" | sed '/^$/d'
}

blog() {
  e2e_scenario blog
  e2e_use_cli
  cd "$ROOT/examples/blog" || exit 1
  step "spin run gen: gen/ is what it writes"
  # SPIN_DEBUG=1: the mode the cybertrain CLI builds gen in, so `cybertrain
  # test` reuses this gen binary.
  SPIN_DEBUG=1 spin run gen
  local changed
  changed=$(git status --porcelain --untracked-files=all -- gen/)
  if [ -n "$changed" ]; then
    echo "examples/blog/gen/ is not what \`spin run gen\` writes with $(spinel --version) (M changed, D gone, ?? never committed):"
    echo "$changed"
    git diff -- gen/
    fail "examples/blog/gen/ is stale"
  fi
  step "cybertrain test"
  cybertrain test
  step "gen --check"
  SPIN_DEBUG=1 spin run gen -- --check
  step "PASS"
}

case "${1:-}" in
  "")
    [ $# -eq 0 ] || exit 2
    legs
    ;;
  --json)
    legs | awk 'BEGIN { printf "[" } { printf "%s\"%s\"", (NR > 1 ? ", " : ""), $1 } END { print "]" }'
    ;;
  run)
    [ $# -eq 2 ] || { echo "usage: script/e2e-legs run LEG" >&2; exit 2; }
    line=$(legs | awk -v leg="$2" '$1 == leg')
    [ -n "$line" ] || { echo "e2e-legs: no leg $2 (script/e2e-legs lists them)" >&2; exit 2; }
    read -r _ cli command args <<< "$line"
    export CYBERTRAIN_E2E_CLI=${CYBERTRAIN_E2E_CLI:-$cli}
    echo "e2e-legs: $2 ($command${args:+ $args}, CYBERTRAIN_E2E_CLI=$CYBERTRAIN_E2E_CLI)"
    if [ "$command" = blog ]; then
      blog
    else
      # shellcheck disable=SC2086 # args is one word or none
      "$ROOT/$command" $args
    fi
    ;;
  *)
    echo "usage: script/e2e-legs [--json | run LEG]" >&2
    exit 2
    ;;
esac

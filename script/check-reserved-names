#!/usr/bin/env ruby
# Guards Cybertrain::Ident::RESERVED_COLUMN_NAMES (the names a column may not
# have, because the generated reader would shadow a method or ivar of
# Cybertrain::Model) and SHADOWING_COLUMN_NAMES (Object methods: noted, not
# refused) against Model growing: every `def name` and every @ivar in
# cybertrain/model.rb (and model/bulk_writes.rb) that a column could be
# spelled like must be in one of the lists, or the next method added to Model
# silently reintroduces the shadowing. That is the hard check (exit 1). Reads the source rather than the
# class: under CRuby model.rb cannot be loaded without SQLite's FFI, and under
# Spinel there is no reflection.
#
# The Object/BasicObject surface is only advisory: it comes from whatever CRuby
# runs this, so a Ruby release that adds a public Object or Kernel method would
# otherwise fail every PR with no change to the framework. Names Ruby exposes
# that are in neither list are printed as a warning and do not fail the step.
# The lists themselves (a name in both, or a keyword in either) stay a hard
# check: that is about the framework's own files. So is the private hooks
# check below: Ruby's own hooks that it calls with an argument
# (initialize_copy on `dup`, singleton_method_added on `def record.x`, ...)
# are private, so Object.instance_methods never lists them, yet a column
# reader of that name raises ArgumentError at Ruby's call. They must be in
# RESERVED_COLUMN_NAMES, never a plain reader and never merely "shadowing".
# It also guards the attachment generator's ATTACHMENT_RESERVED_ACTIONS
# against Cybertrain::Controller growing (see below), and the helper
# generator's HelperScan::RESERVED_HELPER_NAMES against Template::Helpers
# and HelperBase growing (see below), and the job generator's
# JobScan::RESERVED_CLASS_METHODS against jobs_emitter.rb (see below), and
# keeps each method name of NAME_HOMES defined only in the files its row
# lists (see below). Run by CI.
#
# usage: ruby script/check-reserved-names
require File.expand_path("../cybertrain/ident", __dir__)

# Model is model.rb and the files it requires at its end that reopen it
# (model/bulk_writes.rb); every one of them, or a moved name drops out.
source = %w[model.rb model/bulk_writes.rb].map { |f| File.read(File.expand_path("../cybertrain/#{f}", __dir__)) }.join("\n")
names = []
# Instance methods a column reader would redefine: `def save`, `def save!`
# is not (a column cannot be called save!), nor are `def self.x` or
# `def x=`.
source.scan(/^\s*def\s+(?!self\.)([A-Za-z_][A-Za-z0-9_]*)\b(?![?!=])/) { |(m)| names << m }
# attr_reader :id, :errors / attr_accessor / attr_writer: methods too.
source.scan(/^\s*attr_(?:reader|accessor|writer)\s+((?::\w+\s*,?\s*)+)/) do |(list)|
  list.scan(/:(\w+)/) { |(m)| names << m }
end
# Instance variables, from code only: full-line comments are skipped and an
# inline ` # ...` tail is cut, so a `@name` mentioned in prose (or an e-mail
# address) does not demand an entry; `@@class_vars` are not readers.
source.each_line do |line|
  next if line.lstrip.start_with?("#")

  code = line.sub(/\s#\s.*/, "")
  code.scan(/(?<![@\w])@([A-Za-z_][A-Za-z0-9_]*)/) { |(iv)| names << iv }
end
# Object's public instance methods (and BasicObject's hooks such as
# method_missing), which every model has whether or not model.rb mentions
# them: advisory only, see the header. `test`, `select` and the other private
# Kernel methods are not demanded: the list carries the ones the model calls
# on implicit self by hand.
usable = ->(n) { Cybertrain::Ident.column?(n) && !Cybertrain::Ident.keyword?(n) && n != "id" }
object_names = (Object.instance_methods + BasicObject.private_instance_methods).map(&:to_s).uniq.sort.select(&usable)
names = names.uniq.sort.select(&usable)

# Ruby's private hooks: a fixed list (so a Ruby that renames or drops one
# does not shrink the check) plus whatever this Ruby's private methods show
# that is shaped like a hook (`*_added`, `*_removed`, `*_undefined`,
# `*_missing`, `initialize_*`). `respond_to_missing?` and the like end in `?`
# and are not columns, so `usable` drops them.
fixed_hooks = %w[initialize_copy initialize_dup initialize_clone method_missing respond_to_missing?
                 singleton_method_added singleton_method_removed singleton_method_undefined]
private_hooks = (fixed_hooks + (Object.private_instance_methods + BasicObject.private_instance_methods)
  .map(&:to_s).grep(/(?:_added|_removed|_undefined|_missing)\z|\Ainitialize_/)).uniq.sort.select(&usable)

reserved = Cybertrain::Ident::RESERVED_COLUMN_NAMES
shadowing = Cybertrain::Ident::SHADOWING_COLUMN_NAMES
missing = names - reserved - shadowing
advisory = object_names - names - reserved - shadowing
# One home per name: a name in both lists, or a keyword in either, would be
# reported by whichever check runs first and drift the next time one is
# edited.
twice = (reserved & shadowing) + ((reserved + shadowing) & Cybertrain::Ident::RUBY_KEYWORDS)
hooks_missing = private_hooks - reserved
advisory.each do |n|
  warn "advisory: Object##{n} is in neither list; add it to SHADOWING_COLUMN_NAMES when convenient"
end
# The attachment generator adds the download action `def <field>` to the
# owner controller, so CLI::Templates::ATTACHMENT_RESERVED_ACTIONS must name
# every instance method and reader a controller already has: those of
# cybertrain/controller.rb (public or private), and those the generators
# write into ApplicationController (its template and the Authentication
# concern it includes). A field called `params` or `head` would otherwise
# be accepted and break the controller. Names a field cannot have (with ? ! =) are skipped.
$LOAD_PATH.unshift(File.expand_path("..", __dir__))
require "cybertrain/cli/templates"
require "cybertrain/cli/authentication"
controller_source = File.read(File.expand_path("../cybertrain/controller.rb", __dir__))
app_source = Cybertrain::CLI::Templates.application_controller + Cybertrain::CLI::Authentication.authentication_concern
action_names = []
[controller_source, app_source].each do |text|
  text.scan(/^\s*def\s+(?!self\.)([A-Za-z_][A-Za-z0-9_]*)\b(?![?!=])/) { |(m)| action_names << m }
  text.scan(/^\s*attr_(?:reader|accessor)\s+((?::\w+\s*,?\s*)+)/) do |(list)|
    list.scan(/:(\w+)/) { |(m)| action_names << m }
  end
end
action_names = action_names.uniq.sort.grep(/\A[a-z][a-z0-9_]*\z/)
actions_missing = action_names - Cybertrain::CLI::Templates::ATTACHMENT_RESERVED_ACTIONS

# The helper generator mixes every app/helpers module into a subclass of
# Template::Helpers, so Gen::HelperScan::RESERVED_HELPER_NAMES must name
# every method of cybertrain/template/helpers.rb and of HelperBase
# (interpreter.rb), public or private, and every name helper_call answers
# itself (its `when "..."` arms, which reach no app helper).
require "cybertrain/generator/helper_scan"
helpers_source = File.read(File.expand_path("../cybertrain/template/helpers.rb", __dir__))
interpreter_source = File.read(File.expand_path("../cybertrain/template/interpreter.rb", __dir__))
helper_names = helpers_source.scan(/^\s*def\s+(?!self\.)([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten
base = interpreter_source[/class HelperBase\b.*?\n    end\n/m].to_s
helper_names.concat(base.scan(/^\s*def\s+(?!self\.)([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten)
dispatch = helpers_source[/def helper_call\(.*?\n      end\n/m].to_s
dispatch.scan(/^\s*when ((?:"[^"]+"(?:,\s*)?)+)/) { |(list)| helper_names.concat(list.scan(/"([^"]+)"/).flatten) }
helper_names = helper_names.uniq.sort
helpers_missing = helper_names - Cybertrain::Gen::HelperScan::RESERVED_HELPER_NAMES

# A model's `scope :x` is generated as `def x` on its Relation and
# `def self.x` on the model, so Gen::ModelScan::RESERVED_SCOPE_NAMES must
# name every instance method of cybertrain/relation.rb (public or private),
# every `def` the model generator writes into the Relation and the model
# class (models_emitter.rb's emitted `def` and `def self.` lines and its
# DELEGATED list, and the Relation methods association_emitter.rb writes),
# and every class method of cybertrain/model.rb.
require "cybertrain/generator/models_emitter"
# relation.rb and the file it requires at its end that reopens Relation.
relation_source = %w[relation.rb relation/aggregates.rb].map { |f| File.read(File.expand_path("../cybertrain/#{f}", __dir__)) }.join("\n")
emitter_source = File.read(File.expand_path("../cybertrain/generator/models_emitter.rb", __dir__))
scope_names = relation_source.scan(/^\s*def\s+(?!self\.)([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten
scope_names.concat(relation_source.scan(/^\s*attr_reader\s+((?::\w+\s*,?\s*)+)/).flatten.join(" ").scan(/:(\w+)/).flatten)
emitted_relation = emitter_source[/def self\.emit_relation\(.*?\n      end\n/m].to_s
scope_names.concat(emitted_relation.scan(/src << "  def ([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten)
scope_names.concat(emitter_source.scan(/src << "  def self\.([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten)
# association_emitter.rb writes Relation methods too: emit_includes
# (includes, preload, preloaded) and emit_preload_association.
association_source = File.read(File.expand_path("../cybertrain/generator/association_emitter.rb", __dir__))
%w[emit_includes emit_preload_association].each do |m|
  body = association_source[/def self\.#{m}\(.*?\n      end\n/m].to_s
  abort "check-reserved-names: association_emitter.rb has no #{m}" if body.empty?
  scope_names.concat(body.scan(/"(?:\\n)?  def ([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten)
end
scope_names.concat(Cybertrain::Gen::ModelsEmitter::DELEGATED)
scope_names.concat(source.scan(/^\s*def\s+self\.([a-z_][A-Za-z0-9_]*[?!]?)(?!=)/).flatten)
scope_names = scope_names.uniq.sort
scopes_missing = scope_names - Cybertrain::Gen::ModelScan::RESERVED_SCOPE_NAMES

# gen/jobs.rb writes class methods into every job class, so
# Gen::JobScan::RESERVED_CLASS_METHODS must name every `def self.x`
# jobs_emitter.rb emits: a job class defining one itself is refused.
require "cybertrain/generator/job_scan"
jobs_emitter_source = File.read(File.expand_path("../cybertrain/generator/jobs_emitter.rb", __dir__))
job_names = jobs_emitter_source.scan(/out << "  def self\.([a-z_][A-Za-z0-9_]*[?!]?)/).flatten.uniq.sort
abort "check-reserved-names: jobs_emitter.rb emits no `def self.` line" if job_names.empty?
jobs_missing = job_names - Cybertrain::Gen::JobScan::RESERVED_CLASS_METHODS

# One return type per method name across the program (spikes/NOTES.md
# rules 10, 34 and 41): a name that more than one class defines, or that a
# later phase gives a new home, has a row here naming every file allowed to
# `def` it (instance or `def self.`), today's definers and the homes the
# phase 4a and 4b plans give it (seeded once per phase, so tasks running in
# parallel never edit the table; a name the plan did not foresee is added
# by its task). A
# `def` of a listed name in any other file under cybertrain/ fails the
# check, as does an emitted `def` line (a String in
# cybertrain/generator/*_emitter.rb), which counts as its emitter's. A name
# with no row is not checked: a brand-new name with no other definer needs
# none. Rows may name files that do not exist yet. An empty row
# (remember) means no file may define the name.
NAME_HOMES = {
  "format" => %w[cybertrain/console/printer.rb cybertrain/http/request.rb],
  "expect" => %w[cybertrain/mailer.rb cybertrain/params.rb],
  "select" => %w[cybertrain/template/form_builder.rb],
  # cli/templates.rb's is `def self.layout` (the generated layout's text);
  # active_support.rb's, like the other declarations below, is the no-op
  # that lets a concern's never-run `included` block compile
  # (spikes/NOTES.md rule 92), returning nil as Controller's does.
  # config.rb's is the `attr_accessor :layout` of Config (a String).
  "layout" => %w[cybertrain/cli/templates.rb cybertrain/controller.rb cybertrain/active_support.rb cybertrain/config.rb],
  "before_action" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  "after_action" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  "skip_before_action" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  "rate_limit" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  # Controller#rate_limit_key raises; gen/controllers.rb's answers the by: method's String.
  "rate_limit_key" => %w[cybertrain/controller.rb cybertrain/generator/controllers_emitter.rb],
  "rescue_from" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  "helper_method" => %w[cybertrain/controller.rb cybertrain/active_support.rb],
  # What gen/concerns.rb calls around a model concern's spliced `included`
  # body (spec 4.2); both return nil.
  "model_concern_insert_at" => %w[cybertrain/model.rb],
  "model_concern_insert_done" => %w[cybertrain/model.rb],
  # Controller#cookies is the CookieJar; Response#cookies the Set-Cookie
  # values sent (Array<String>); Test::Client#cookies the client's jar
  # (Hash). Three return types under one name, kept apart by their
  # receivers (a Response, a Client and a Controller never share a
  # variable); a fourth definer needs a reason here.
  "cookies" => %w[cybertrain/controller.rb cybertrain/http/response.rb cybertrain/test/client.rb],
  "signed" => %w[cybertrain/cookie_jar.rb],
  # model_scan.rb's is ModelInfo's `attr_reader ... :encrypted` (the
  # encrypts attributes, an Array<String>), gen-only: a ModelInfo and a
  # CookieJar never share a variable, so the receivers keep the two return
  # types apart (test programs such as gen_model_concerns.rb compile both).
  "encrypted" => %w[cybertrain/cookie_jar.rb cybertrain/generator/model_scan.rb],
  "permanent" => %w[cybertrain/cookie_jar.rb],
  "html" => %w[cybertrain/format_collector.rb],
  # schema/table.rb's are the `t.json` and `t.text` column types.
  "json" => %w[cybertrain/format_collector.rb cybertrain/schema/table.rb],
  "turbo_stream" => %w[cybertrain/format_collector.rb cybertrain/controller.rb],
  "csv" => %w[cybertrain/format_collector.rb],
  "xml" => %w[cybertrain/format_collector.rb],
  # template/ast.rb's TextNode#text and template/lexer.rb's Token#text are
  # attr_readers (a String), never compiled next to a FormatCollector or a
  # Table receiver.
  "text" => %w[cybertrain/format_collector.rb cybertrain/schema/table.rb cybertrain/template/ast.rb cybertrain/template/lexer.rb],
  # cli/attachment.rb's and cli/scaffold.rb's are the --any option
  # (attr_reader, a Boolean) of the generators' name records.
  "any" => %w[cybertrain/format_collector.rb cybertrain/cli/attachment.rb cybertrain/cli/scaffold.rb],
  "permit" => %w[cybertrain/params.rb],
  # Cache.read (a String or nil), BlobStore.read (a binary String) and
  # Gen::ImportmapReader.read (the pins, an Array, run only by gen): all
  # module functions called on their module, never on a shared receiver.
  "read" => %w[cybertrain/cache.rb cybertrain/blob_store.rb cybertrain/generator/importmap_reader.rb],
  # Assets.install (nil; gen/assets.rb calls it) and CLI::Toolchain.install
  # (true or false; only in the cybertrain command).
  "install" => %w[cybertrain/assets.rb cybertrain/cli/toolchain.rb],
  # Response#redirect returns nil next to the routes DSL's Mapper#redirect
  # (a RedirectSpec, run only by `spin run gen`); both redirect_to return nil.
  "redirect" => %w[cybertrain/http/response.rb cybertrain/generator/routes_dsl.rb],
  "redirect_to" => %w[cybertrain/controller.rb cybertrain/router.rb],
  # The routes DSL's `scope "/v1" do` (nil), the model macro `scope :x,
  # -> { }` (nil) and the generated Gen::Console.scope(name) (a Relation).
  "scope" => %w[cybertrain/generator/routes_dsl.rb cybertrain/model.rb cybertrain/generator/console_emitter.rb],
  # Controller#send_data(data, filename:, ...) answers a download; the
  # Mailer's SMTP connection writes raw bytes with its own send_data(data).
  "send_data" => %w[cybertrain/controller.rb cybertrain/mailer.rb],
  # Phase 4b (plan decision R5): i18n. A String lookup and an Array lookup
  # are separate names (I18n.t / translate -> String, translate_list ->
  # Array<String>; Gen::Locales.lookup -> String or nil, lookup_list ->
  # Array<String>). I18n.t and Controller#t both answer a String.
  # `locale_available?` (and `admin?` below) have no row: the `def` line
  # pattern stops before a `?` name, so a row would check nothing (phase
  # 4b pre-flight finding 21). If Task 4 takes spike 6c's fallback
  # (Controller#locale), it adds cybertrain/controller.rb to `locale`.
  "t" => %w[cybertrain/i18n.rb cybertrain/controller.rb],
  "translate" => %w[cybertrain/i18n.rb cybertrain/controller.rb],
  "l" => %w[cybertrain/i18n.rb],
  "localize" => %w[cybertrain/i18n.rb],
  "translate_list" => %w[cybertrain/i18n.rb],
  "locale" => %w[cybertrain/i18n.rb],
  "with_locale" => %w[cybertrain/i18n.rb],
  "default_locale" => %w[cybertrain/i18n.rb],
  "available_locales" => %w[cybertrain/i18n.rb],
  "preferred_locale" => %w[cybertrain/http/request.rb],
  "human_attribute_name" => %w[cybertrain/i18n.rb cybertrain/generator/models_emitter.rb],
  # gen/locales.rb's Gen::Locales and the checked-in locales/bundled.rb's
  # Cybertrain::BundledLocales, both written by locales_emitter.rb.
  "lookup" => %w[cybertrain/generator/locales_emitter.rb cybertrain/locales/bundled.rb],
  "lookup_list" => %w[cybertrain/generator/locales_emitter.rb cybertrain/locales/bundled.rb],
  # Phase 4b: authentication. `remember` is the sessions.remember column's
  # reader in generated applications, so no framework file defines it
  # (TimeZone's cache writer is remember_zone).
  "remember" => %w[],
  # Mailer.deliver_later and MailMessage#deliver_later both answer the
  # job's id (an Integer).
  "deliver_later" => %w[cybertrain/mailer/later.rb cybertrain/mail_message.rb],
  # The Controller class method, and the 0.4 block's own copy inside
  # cli/authentication.rb's ApplicationController text.
  "allow_unauthenticated_access" => %w[cybertrain/controller.rb cybertrain/cli/authentication.rb],
  "password_reset_token" => %w[cybertrain/cli/authentication.rb],
  # Every CLI generator's `generate` answers the paths it created
  # (Array<String>). A generator that needs to answer more takes a new
  # name, as phase 4b's do (pre-flight finding 3): the signed token is
  # Token.issue (cybertrain/token.rb), and the authentication generator's
  # GenerateResult comes from Authentication.generate_with_result, which
  # cli.rb calls, beside Authentication.generate.
  "generate" => %w[cybertrain/cli/helper.rb cybertrain/cli/job.rb cybertrain/cli/authentication.rb
                   cybertrain/cli/component.rb cybertrain/cli/scaffold.rb cybertrain/cli/attachment.rb],
  "issue" => %w[cybertrain/token.rb],
  "generate_with_result" => %w[cybertrain/cli/authentication.rb],
  # The Turbo Stream actions: Turbo.x (SafeString), TurboStreams#x
  # (SafeString, the controller's builder). Model#update returns a Boolean
  # (compiled side by side with TurboStreams#update in test/turbo_helpers.rb
  # and test/application.rb's program); cli/templates.rb's is the
  # generated controller's `update` action, written in a template String.
  "update" => %w[cybertrain/model.rb cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb cybertrain/cli/templates.rb],
  "replace" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb],
  "append" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb],
  "prepend" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb],
  "before" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb],
  "after" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb],
  "remove" => %w[cybertrain/turbo.rb cybertrain/turbo_stream_renderer.rb]
}.freeze
# The names the phase 4a and 4b plans list as the first candidates for a
# clash must keep a row (Global Constraints of the plans; 4b's `admin?` is
# left out, see `t` above).
NAME_CANDIDATES = %w[select format expect layout cookies signed encrypted permanent html json turbo_stream
                     csv xml text any permit scope t l translate localize locale remember].freeze
root = File.expand_path("..", __dir__)
home_rows_missing = NAME_CANDIDATES - NAME_HOMES.keys
homeless = []
# `def x`, `def self.x`, `private def x` and `protected def x`; an
# attr_reader, attr_accessor or attr_writer line defines each name it lists
# (a writer's `x=` is a different name, but the line is counted all the
# same: a reader of the name is never far behind), its continuation lines
# too while a line ends in a comma (attr_names).
def_line = /^\s*(?:(?:private|protected|public)\s+)?def\s+(?:self\.)?([a-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_?!=])/
attr_line = /^\s*(?:(?:private|protected|public)\s+)?attr_(?:reader|accessor|writer)\s+((?::[a-z_][A-Za-z0-9_]*\s*,?\s*)+)/
emitted_def = /(?:"|\\n)\s*def\s+(?:self\.)?([a-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_?!=])/
# The names of the attr_* call starting at lines[index] (none when it is
# not one), read across the lines that follow while the text so far ends in
# a comma (a trailing ` # comment` aside).
attr_names = lambda do |lines, index|
  listed = []
  a = lines[index].match(attr_line)
  return listed if a.nil?

  text = lines[index].sub(/\s#\s.*/, "").rstrip
  k = index + 1
  while text.end_with?(",") && k < lines.size
    text = "#{text} #{lines[k].sub(/\s#\s.*/, "").strip}"
    k += 1
  end
  text.sub(/\A\s*(?:(?:private|protected|public)\s+)?attr_(?:reader|accessor|writer)\s+/, "").scan(/:([a-z_][A-Za-z0-9_]*)/) { |(name)| listed << name }
  listed
end
# The line shapes pin themselves: a regex edit that stops reading
# `private def x`, a multi-name attr_reader or its continuation lines fails
# here rather than silently passing every file. A sample of several lines
# is read from its first.
{ "    private def layout_path(x)" => ["layout_path"], "  protected def self.x" => ["x"], "  def cookies" => ["cookies"],
  "    attr_reader :status, :cookies" => %w[status cookies], "  attr_accessor :layout" => ["layout"],
  "    attr_reader :file, :class_name,\n                :condition_methods, :encrypted\n" => %w[file class_name condition_methods encrypted],
  "  attr_reader :a, # the first\n              :b\n  def c = 1\n" => %w[a b],
  "  attr_reader :a\n  attr_reader :b\n" => ["a"],
  "  def x=(v)" => [], "  # def cookies" => [] }.each do |sample, want|
  got = []
  m = sample.lines[0].match(def_line)
  got << m[1] unless m.nil?
  attr_names.call(sample.lines, 0).each { |name| got << name }
  abort "check-reserved-names: self-check: #{sample.strip.inspect} gives #{got.inspect}, expected #{want.inspect}" unless got == want
end
Dir.glob(File.join(root, "cybertrain", "**", "*.rb")).sort.each do |file|
  rel = file.delete_prefix("#{root}/")
  emitter = rel.match?(%r{\Acybertrain/generator/[^/]+_emitter\.rb\z})
  lines = File.readlines(file, encoding: "UTF-8")
  lines.each_with_index do |line, index|
    number = index + 1
    next if line.lstrip.start_with?("#")

    found = []
    m = line.match(def_line)
    found << m[1] unless m.nil?
    attr_names.call(lines, index).each { |name| found << name }
    line.scan(emitted_def) { |(name)| found << name } if emitter
    found.uniq.each do |name|
      homes = NAME_HOMES[name]
      next if homes.nil? || homes.include?(rel)

      homeless << [rel, number, name, homes]
    end
  end
end

if missing.empty? && twice.empty? && hooks_missing.empty? && actions_missing.empty? && helpers_missing.empty? && scopes_missing.empty? &&
   jobs_missing.empty? && homeless.empty? && home_rows_missing.empty?
  puts "check-reserved-names: #{names.size} Model names, all reserved or noted (#{advisory.size} advisory Object names, #{private_hooks.size} private hooks reserved); #{action_names.size} controller methods refused as attachment names; #{helper_names.size} template helper names refused as app helper names; #{scope_names.size} Relation and model class methods refused as scope names; #{job_names.size} generated job class methods refused as job class methods; #{NAME_HOMES.size} shared method names defined only in their homes"
else
  homeless.each do |rel, number, name, homes|
    where = homes.empty? ? "no file may define it yet" : "its homes are #{homes.join(", ")}"
    warn "check-reserved-names: #{rel}:#{number} defines `#{name}`, but #{where} (NAME_HOMES in script/check-reserved-names): " \
         "one return type per method name across the program (spikes/NOTES.md rules 10, 34, 41); rename the method, " \
         "or add the file to the row if it returns the same type"
  end
  unless home_rows_missing.empty?
    warn "check-reserved-names: NAME_HOMES has no row for #{home_rows_missing.map(&:inspect).join(", ")} " \
         "(a candidate name of the phase 4a or 4b plan); add one"
  end
  unless jobs_missing.empty?
    warn "check-reserved-names: gen/jobs.rb defines #{jobs_missing.map(&:inspect).join(", ")} on every job class " \
         "(cybertrain/generator/jobs_emitter.rb) but Cybertrain::Gen::JobScan::RESERVED_CLASS_METHODS " \
         "(cybertrain/generator/job_scan.rb) does not refuse it as a job's own class method; add it"
  end
  unless scopes_missing.empty?
    warn "check-reserved-names: a model's Relation or class already has #{scopes_missing.map(&:inspect).join(", ")} " \
         "(cybertrain/relation.rb, relation/aggregates.rb, model.rb, model/bulk_writes.rb or what models_emitter.rb generates) but " \
         "Cybertrain::Gen::ModelScan::RESERVED_SCOPE_NAMES (cybertrain/generator/model_scan.rb) does not refuse it as a scope name; add it"
  end
  unless helpers_missing.empty?
    warn "check-reserved-names: the template helpers define or answer #{helpers_missing.map(&:inspect).join(", ")} " \
         "(cybertrain/template/helpers.rb or HelperBase) but Cybertrain::Gen::HelperScan::RESERVED_HELPER_NAMES " \
         "(cybertrain/generator/helper_scan.rb) does not refuse it as an app helper name; add it"
  end
  unless actions_missing.empty?
    warn "check-reserved-names: a controller already has #{actions_missing.map(&:inspect).join(", ")} " \
         "(cybertrain/controller.rb or the generated ApplicationController) but Cybertrain::CLI::Templates::ATTACHMENT_RESERVED_ACTIONS " \
         "(cybertrain/cli/templates.rb) does not refuse it as an attachment field name; add it"
  end
  unless missing.empty?
    warn "check-reserved-names: cybertrain/model.rb defines #{missing.map(&:inspect).join(", ")} " \
         "but neither Cybertrain::Ident::RESERVED_COLUMN_NAMES nor SHADOWING_COLUMN_NAMES (cybertrain/ident.rb) has them; add them"
  end
  unless hooks_missing.empty?
    warn "check-reserved-names: Ruby calls #{hooks_missing.map(&:inspect).join(", ")} on a record with an argument (a private hook, so " \
         "Object.instance_methods does not show it); it must be in Cybertrain::Ident::RESERVED_COLUMN_NAMES " \
         "(cybertrain/ident.rb), not SHADOWING_COLUMN_NAMES, or a column so named raises ArgumentError at Ruby's call"
  end
  warn "check-reserved-names: #{twice.map(&:inspect).join(", ")} listed twice (reserved, shadowing or keyword)" unless twice.empty?
  exit 1
end

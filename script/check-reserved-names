  "year" => %w[cybertrain/zoned_time.rb],
  "wday" => %w[cybertrain/zoned_time.rb],
  "yday" => %w[cybertrain/zoned_time.rb],
  "utc_offset" => %w[cybertrain/zoned_time.rb],
  "to_time" => %w[cybertrain/zoned_time.rb],
  "to_date" => %w[cybertrain/zoned_time.rb],
  "travel" => %w[cybertrain/test/time_helpers.rb cybertrain/clock.rb],
  "travel_to" => %w[cybertrain/test/time_helpers.rb cybertrain/clock.rb],
  "travel_back" => %w[cybertrain/test/time_helpers.rb cybertrain/clock.rb],
  "freeze_time" => %w[cybertrain/test/time_helpers.rb cybertrain/clock.rb],
  # Clock.monotonic and DB::Connection.monotonic (the busy wait's deadline)
  # both answer CLOCK_MONOTONIC seconds as a Float (Task 2; test/clock.rb
  # compiles them with test.rb, test/time_travel.rb with the whole framework).
  "monotonic" => %w[cybertrain/db/connection.rb cybertrain/clock.rb],
  # CLI::Toolchain.setup (the `cybertrain setup` command); the top-level
  # setup / teardown blocks; Test::Base#setup / #teardown (nil) beside the
  # class methods of the same name that refuse an unrewritten file (D9).
  "setup" => %w[cybertrain/cli/toolchain.rb cybertrain/test.rb cybertrain/test/test_case.rb],
  "teardown" => %w[cybertrain/cli/toolchain.rb cybertrain/test.rb cybertrain/test/test_case.rb],
  "test" => %w[cybertrain/test.rb cybertrain/test/test_case.rb],
  "fixtures" => %w[cybertrain/test/test_case.rb],
  # One method for the component and the partial form (rule 34); the
  # generated helper tests' local one (cli/helper.rb's text) is renamed.
  "render_inline" => %w[cybertrain/test/views.rb],
  "assert_select" => %w[cybertrain/test/select.rb],
  "node_tag" => %w[cybertrain/test/html_reader.rb],
  "node_attr" => %w[cybertrain/test/html_reader.rb],
  "node_text" => %w[cybertrain/test/html_reader.rb],
  "node_html" => %w[cybertrain/test/html_reader.rb],
  "deliveries" => %w[cybertrain/mailer.rb],
  # The last Response everywhere: Test::Client's, the Context's, the
  # Controller's and IntegrationTest's.
  "response" => %w[cybertrain/test/client.rb cybertrain/context.rb cybertrain/controller.rb cybertrain/test/integration.rb],
  # The top-level assert_response(response, expected) beside
  # IntegrationTest#assert_response(expected): both nil, one shared helper
  # (pre-flight R17).
  "assert_response" => %w[cybertrain/test/client.rb cybertrain/test/integration.rb],
  "assert_redirected_to" => %w[cybertrain/test/client.rb cybertrain/test/integration.rb],
  # The requests: HttpClient's, the routes DSL's (gen only), Test::Client's
  # and the Router's, plus IntegrationTest's (each answers the Response).
  # delete: Session#delete, CookieJar#delete and its subclasses,
  # BlobStore.delete and Cache.delete too. head: Controller#head(status)
  # beside IntegrationTest#head(path). Spike item 3 compiled the
  # IntegrationTest methods beside all of them.
  "get" => %w[cybertrain/http_client.rb cybertrain/generator/routes_dsl.rb cybertrain/test/client.rb cybertrain/router.rb
              cybertrain/test/integration.rb],
  "post" => %w[cybertrain/http_client.rb cybertrain/generator/routes_dsl.rb cybertrain/test/client.rb cybertrain/router.rb
               cybertrain/test/integration.rb],
  "patch" => %w[cybertrain/generator/routes_dsl.rb cybertrain/test/client.rb cybertrain/router.rb cybertrain/test/integration.rb],

  "ago" => %w[cybertrain/durations.rb],
  "from_now" => %w[cybertrain/durations.rb],
  # Integer#hour / #day (seconds, an Integer) and ZonedTime#hour / #day
  # (the wall clock's, an Integer), beside the builtin Time#hour / #day.
  "hour" => %w[cybertrain/durations.rb cybertrain/zoned_time.rb],
  "day" => %w[cybertrain/durations.rb cybertrain/zoned_time.rb],
  "min" => %w[cybertrain/zoned_time.rb],

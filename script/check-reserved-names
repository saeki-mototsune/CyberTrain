              cybertrain/test/time_now.rb],
  # Schema.current (the Definition, or nil), Time.current (a Time) and
  # Date.current (a Date), the last two in clock.rb.
  "current" => %w[cybertrain/schema.rb cybertrain/clock.rb],
  # Clock.zone and Time.zone answer a TimeZone; ZonedTime#zone the
  # abbreviation (a String, as the builtin Time#zone).
  "zone" => %w[cybertrain/clock.rb cybertrain/zoned_time.rb],
  # Template::Parser#advance (the token cursor) and Time#advance(months: 1)
  # (a Time). Stream::Poller's was renamed advance_to (pre-flight B1).
  "advance" => %w[cybertrain/template/parser.rb cybertrain/time_ext.rb],
  # Integer#seconds and the rest answer an Integer; Net::Timer's
  # formatter was renamed format_seconds (pre-flight B1). Cron::Expression's
  # public readers minutes / hours / days answer Array<Integer>, kept apart
  # from Integer's by their receivers (spike item 2 compiled both).
  "seconds" => %w[cybertrain/durations.rb],
  "minutes" => %w[cybertrain/durations.rb cybertrain/cron.rb],
  "hours" => %w[cybertrain/durations.rb cybertrain/cron.rb],
  "days" => %w[cybertrain/durations.rb cybertrain/cron.rb],
  "weeks" => %w[cybertrain/durations.rb],
  "second" => %w[cybertrain/durations.rb],
  "minute" => %w[cybertrain/durations.rb],

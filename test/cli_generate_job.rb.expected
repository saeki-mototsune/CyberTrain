create app/jobs/send_digest_job.rb
create test/send_digest_job.rb

next:
  spin run gen           # writes gen/jobs.rb (perform_later and the retry arms)
  cybertrain spin test   # test/send_digest_job.rb; snapshot it from the binary
ok   generate job send_digest writes a Job::Base subclass with an empty perform and a test
identical app/jobs/send_digest_job.rb
identical test/send_digest_job.rb

next:
  spin run gen           # writes gen/jobs.rb (perform_later and the retry arms)
  cybertrain spin test   # test/send_digest_job.rb; snapshot it from the binary

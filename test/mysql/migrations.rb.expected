Cybertrain::Schema.define(version: "20270301000200") do |s|
  s.create_table "mig_children" do |t|
    t.integer "mig_parent_id", null: false
    t.string "label"
    t.integer "owner_id"
  end

  s.create_table "mig_parents" do |t|
    t.string "name", null: false
  end

  s.add_index "mig_children", ["mig_parent_id"], name: "index_mig_children_on_mig_parent_id"
  s.add_index "mig_children", ["owner_id"], name: "index_mig_children_on_owner_id"

  s.add_foreign_key "mig_children", "mig_parents", column: "mig_parent_id", on_delete: :cascade
  s.add_foreign_key "mig_children", "mig_parents", column: "owner_id", on_delete: :nullify
end

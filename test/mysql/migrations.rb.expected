Cybertrain::Schema.define(version: "20270201000300") do |s|
  s.create_table "mig_items" do |t|
    t.string "title", null: false
  end

  s.add_index "mig_items", "(lower(`title`)), `id`", name: "index_mig_items_on_lower_title"

end

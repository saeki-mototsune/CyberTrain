Cybertrain::Schema.define(version: "20270201000100") do |s|
  s.create_table "mig_items" do |t|
    t.string "title", null: false, limit: 80
    t.text "content"
    t.decimal "price", precision: 10, scale: 2
    t.date "due_on"
    t.json "meta"
    t.binary "data"
    t.bigint "views", null: false, default: "0"
    t.string "state", null: false, default: "'draft'"
    t.string "subtitle"
  end

  s.add_index "mig_items", ["state", "due_on"], name: "index_mig_items_on_state_and_due_on"
  s.add_index "mig_items", ["title"], unique: true, name: "index_mig_items_on_title"

end

# Kamal config of the hosted playground's router (SP2): a stock Caddy that
# kamal-proxy hands every request for <DOMAIN> and *.<DOMAIN>. Copy to
# playground/deploy/router.yml (git-ignored) and fill in the placeholders.
#
#   kamal setup  -c playground/deploy/router.yml   # once, before the control plane
#   kamal deploy -c playground/deploy/router.yml   # rarely: live editors reconnect (playground/deploy/README.md)
service: cybertrain-play-router
# A package of <GHCR_OWNER>, the deploy account (registry below).
image: <GHCR_OWNER>/cybertrain-play-router
minimum_version: 2.12.0

servers:
  web:
    hosts:
      - <VPS_IP>
    options:
      network-alias: ctplay-router
      # No outside resolver: the router needs none, and the ids of ended
      # sessions must not reach the host's.
      dns: 127.0.0.1
      # It spans the kamal network and every session network: it forwards
      # nothing at the IP level (spec §15, correction 6).
      sysctl: net.ipv4.ip_forward=0
      # Every editor, every preview and the entry go through this one
      # router: a flood of connections must cost a router restart (Kamal
      # runs it with --restart unless-stopped), not the host's memory. Caddy
      # idles at about 17 MiB with a dozen threads and stayed under 30 MiB and
      # 17 threads in the end-to-end test; an idle connection held open
      # costs it about 11 KB (16,000 held: 188 MiB, 18 threads). 512 MiB
      # stops a flood at some 45,000 such connections; no swap, as for the
      # sessions.
      memory: 512m
      memory-swap: 512m
      pids-limit: 256

proxy:
  hosts:
    - <DOMAIN>
    - "*.<DOMAIN>"
  app_port: 80
  ssl:
    certificate_pem: CERTIFICATE_PEM
    private_key_pem: PRIVATE_KEY_PEM
  forward_headers: false
  # POST /sessions waits for the new session (up to PLAY_READY_TIMEOUT, 30 s).
  response_timeout: 60
  # kamal-proxy reads a request's whole body before the router sees it (by
  # default up to 1 GB, on disk beyond 1 MB), so the router's 4 KB limit on
  # the apex alone could not keep a large body off the host's disk. No host
  # of this service needs more than 1 MB (uploads are off in the editor,
  # whose traffic is a WebSocket; the preview's forms are small): bodies up
  # to 1 MB stay in memory, larger ones are refused. Responses are not
  # buffered: by default kamal-proxy buffers them with no size limit and
  # writes what exceeds memory to disk, and the preview hosts serve
  # strangers' apps, so one visitor could fill the host's disk. Unbuffered,
  # kamal-proxy streams them to its client, Cloudflare.
  buffering:
    requests: true
    responses: false
    max_request_body: 1_000_000
    memory: 1_000_000
  healthcheck:
    path: /up
    interval: 1
    timeout: 3

# <GHCR_OWNER> is a GitHub account of its own that owns only the router's and
# the control plane's images (playground/deploy/README.md, 1-4), not
# saeki-mototsune, which owns the public session and Codespaces images. Kamal
# logs in to GHCR on the VPS at every setup and deploy and leaves this token
# (KAMAL_REGISTRY_PASSWORD) there: it must not be able to push those two.
registry:
  server: ghcr.io
  username: <GHCR_OWNER>
  password:
    - KAMAL_REGISTRY_PASSWORD

builder:
  arch: amd64
  context: .
  dockerfile: playground/router/Dockerfile

env:
  clear:
    PLAY_DOMAIN: <DOMAIN>
    PLAY_PUBLIC_URL: https://<DOMAIN>
    # The same value as PLAY_SUBNET_POOL in control.yml and as POOL in
    # playground/deploy/host/cybertrain-play-firewall: the router closes
    # connections that come from the pool, and the firewall drops traffic
    # from it. pre-deploy compares router.yml with control.yml.
    PLAY_SUBNET_POOL: 10.250.0.0/16

# pre-build refuses to build the router's image from a tree unlike its
# commit; pre-deploy refuses a router deploy without readable, non-empty
# certificate files (PLAY_ORIGIN_CERT, PLAY_ORIGIN_KEY) or with a pool unlike
# control.yml's. verbose: Kamal shows the hooks' messages, which it hides by
# default.
hooks_path: playground/deploy/hooks
hooks_output: verbose

logging:
  options:
    max-size: 10m
    max-file: "3"

# Non-root deploy user in the docker group on the VPS.
ssh:
  user: deploy

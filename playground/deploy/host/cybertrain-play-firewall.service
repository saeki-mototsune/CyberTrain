[Unit]
Description=cybertrain playground host firewall rules
After=docker.service
Requires=docker.service
PartOf=docker.service
# The retries below end after 5 starts within 2 minutes: a lasting failure
# (an empty Cloudflare list, say) leaves the unit failed instead of looping.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cybertrain-play-firewall
# A failure at boot (a late default route, the xtables lock) is retried.
Restart=on-failure
RestartSec=10

[Install]
# docker.service too: a start of Docker (not only a boot or a restart) runs
# the rules again, and the unit is not left shown inactive.
WantedBy=multi-user.target docker.service

#!/usr/bin/env bash
# cybertrain-play-firewall -- host rules of the hosted playground (SP2), run
# by cybertrain-play-firewall.service after Docker starts and whenever Docker
# restarts; safe to run again (it rebuilds its own chains).
#   POOL     the session subnet pool (PLAY_SUBNET_POOL)   default 10.250.0.0/16
#   EXT_IF   the public interface                         default: the default route's
#   CF_LIST  Cloudflare's IPv4 ranges, one per line        default /etc/cybertrain-play/cloudflare-ips-v4
#            (from https://www.cloudflare.com/ips-v4, which has no final newline)
#   LOCK_FILE  held for the whole run (runs never overlap)
#              default /run/cybertrain-play-firewall/lock (the unit's RuntimeDirectory)
# It checks everything first: CF_LIST must hold at least one range and only
# IPv4 ranges (a.b.c.d/n), POOL must be one, EXT_IF must name an interface of
# this host, and Docker's DOCKER-USER chain must exist. Otherwise it changes
# nothing, says why and exits 1: the rules in force stay (on a first run
# there are none, and ports 80/443 stay open to everyone). Then it applies
# the whole rule set in one `iptables-restore --noflush` transaction: packets
# see either the previous complete rules or the new ones, also when the run
# is interrupted or the kernel refuses a rule (which it names, exiting 1).
set -uo pipefail
export LC_ALL=C
fail() { echo "cybertrain-play-firewall: $*; nothing changed" >&2; exit 1; }

# One run at a time: a second run waits for the first, so that two runs can
# never both find the INPUT rule or the jump missing and both add it. The
# lock is in root's own directory, not in /run/lock, which every user can
# write; the unit makes it, and a run by hand before the unit's first start
# makes it here.
LOCK_FILE=${LOCK_FILE:-/run/cybertrain-play-firewall/lock}
mkdir -p "$(dirname "$LOCK_FILE")" 2> /dev/null
{ exec 9> "$LOCK_FILE"; } 2> /dev/null || fail "cannot open the lock file $LOCK_FILE"
flock -w 60 9 || fail "another run still holds $LOCK_FILE after 60 s"

POOL=${POOL:-10.250.0.0/16}
EXT_IF=${EXT_IF:-$(ip -4 route show default | awk '{print $5; exit}')}
CF_LIST=${CF_LIST:-/etc/cybertrain-play/cloudflare-ips-v4}

# An IPv4 range: four octets 0-255 without leading zeros, and a prefix length
# from 8 to 32 (anything wider is neither a Cloudflare range nor a pool). An
# interface name never starts with -, which a command would take for an
# option.
octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
range_re="^$octet(\\.$octet){3}/([89]|[12][0-9]|3[0-2])\$"
ifname_re='^[A-Za-z0-9_.][A-Za-z0-9_.-]{0,14}$'

[[ $POOL =~ $range_re ]] || fail "POOL is not an IPv4 range a.b.c.d/n (n from 8 to 32): $(printf '%q' "$POOL")"
[[ $EXT_IF =~ $ifname_re ]] || fail "EXT_IF is empty or not an interface name: $(printf '%q' "$EXT_IF") (no default route? set EXT_IF)"
ip link show dev "$EXT_IF" > /dev/null 2>&1 || fail "EXT_IF ($EXT_IF) is not an interface of this host (set EXT_IF)"
[ -f "$CF_LIST" ] || fail "$CF_LIST is missing (save https://www.cloudflare.com/ips-v4 there)"
edge=""
count=0
lineno=0
# `|| [ -n "$range" ]` keeps the last line, which has no newline.
while read -r range || [ -n "$range" ]; do
  lineno=$((lineno + 1))
  [ -n "$range" ] || continue
  [[ $range =~ $range_re ]] || fail "line $lineno of $CF_LIST is not an IPv4 range a.b.c.d/n (n from 8 to 32): $(printf '%q' "$range")"
  edge+="-A CTPLAY-EDGE -s $range -j RETURN"$'\n'
  count=$((count + 1))
done < "$CF_LIST"
[ "$count" -gt 0 ] || fail "$CF_LIST holds no range (save https://www.cloudflare.com/ips-v4 there): ports 80/443 stay as they are, open to everyone if no run has closed them"
iptables -w -S DOCKER-USER > /dev/null 2>&1 ||
  fail "Docker's DOCKER-USER chain cannot be read (is Docker running with its iptables rules, and is this run as root?)"

# The rule set, for iptables-restore --noflush: declaring CTPLAY and
# CTPLAY-EDGE creates them or empties them inside the same transaction, and
# the INPUT rule and the jump from DOCKER-USER go in only when missing, so
# that a run leaves one copy of everything.
#   INPUT        a session never talks to the host itself (its bridge has no
#                host address with inhibit_ipv4; this covers the case where
#                it has one)
#   DOCKER-USER  forwarded traffic, checked before Docker's own rules
#   CTPLAY       cloud metadata dropped, from any container; ports 80/443 from
#                the public interface only from Cloudflare (CTPLAY-EDGE);
#                router <-> session on one bridge let through; anything
#                routed out of a session network dropped
rules="*filter
:CTPLAY - [0:0]
:CTPLAY-EDGE - [0:0]
-A CTPLAY -d 169.254.169.254/32 -j DROP
-A CTPLAY -i $EXT_IF -p tcp -m conntrack --ctorigdstport 80 --ctdir ORIGINAL -j CTPLAY-EDGE
-A CTPLAY -i $EXT_IF -p tcp -m conntrack --ctorigdstport 443 --ctdir ORIGINAL -j CTPLAY-EDGE
-A CTPLAY -m physdev --physdev-is-bridged -j RETURN
-A CTPLAY -s $POOL -j DROP
${edge}-A CTPLAY-EDGE -j DROP
"
iptables -w -C INPUT -s "$POOL" -j DROP 2> /dev/null || rules+="-I INPUT 1 -s $POOL -j DROP"$'\n'
iptables -w -C DOCKER-USER -j CTPLAY 2> /dev/null || rules+="-I DOCKER-USER 1 -j CTPLAY"$'\n'
rules+="COMMIT"$'\n'

if ! err=$(printf '%s' "$rules" | iptables-restore -w --noflush 2>&1); then
  line=$(printf '%s\n' "$err" | sed -n 's/.*line:\{0,1\} \([0-9][0-9]*\).*/\1/p' | head -n 1)
  what="the rule set"
  [ -n "$line" ] && what="the rule '$(printf '%s' "$rules" | sed -n "${line}p")'"
  echo "cybertrain-play-firewall: iptables-restore refused $what; nothing changed (the previous rules stay in force):" >&2
  printf '%s\n' "$err" | sed 's/^/  /' >&2
  exit 1
fi
echo "cybertrain-play-firewall: rules in force: $count Cloudflare ranges on $EXT_IF, session pool $POOL"

#!/usr/bin/env bash
# playground-server [APP_DIR]
#
# Starts `cybertrain server` for the playground's app (default
# /workspace/blog) in the foreground of this terminal. GitHub Codespaces runs
# it from postAttachCommand on every attach, so a second run must not start a
# second server: it prints where the app is and exits 0 instead when
#   - its lock is held: a server this script started is running;
#   - the port answers: a server started by hand is listening;
#   - this user runs a `cybertrain server` that does not listen yet: one
#     started by hand is still compiling (about a minute after a Ruby edit).
set -u

app="${1:-/workspace/blog}"
port="${PORT:-3000}"

# The toolchain on PATH.
. /etc/profile.d/cybertrain-playground.sh

if [ "${CODESPACES:-}" = "true" ] && [ -n "${CODESPACE_NAME:-}" ]; then
  url="https://${CODESPACE_NAME}-${port}.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}/"
else
  url="http://localhost:${port}/"
fi

# One server per port. `cybertrain server` inherits the lock and holds it
# until it exits.
exec 9>"/tmp/playground-server-${port}.lock"
if ! flock -n 9; then
  echo "playground-server: the dev server is already running: ${url}"
  exit 0
fi
if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
  echo "playground-server: port ${port} is already in use, so no second server is started: ${url}"
  exit 0
fi
# A `cybertrain server` started by hand holds neither the lock nor, until it
# has compiled the app, the port. It is the gem's Ruby script, whose command
# line is "/usr/bin/ruby3.2 /usr/local/bin/cybertrain server [PORT]";
# anchoring on the interpreter skips a shell or init whose arguments merely
# mention it.
if pgrep -u "$(id -u)" -f '^[^ ]*ruby[^ ]* [^ ]*/cybertrain server( |$)' >/dev/null 2>&1; then
  echo "playground-server: a cybertrain server is already starting, so no second server is started: ${url}"
  exit 0
fi
if [ ! -f "${app}/spin.toml" ]; then
  echo "playground-server: ${app} is not a cybertrain app (no spin.toml)" >&2
  exit 1
fi

cat <<EOF

  cybertrain playground
  App    ${url}
  Guide  ${app}/PLAYGROUND.md

  Views reload on the next request. A Ruby change rebuilds the app (about a
  minute), then the server restarts by itself. Reload the page to see either.
  Ctrl-C stops the server; run playground-server to start it again.
EOF
if command -v code >/dev/null 2>&1; then
  cat <<EOF

  The app opens in a new browser tab, not inside VS Code. If no tab opened
  (a pop-up blocker), Ctrl-click (Cmd-click on a Mac) the App link above, or
  click "Open in Browser" in VS Code's notification or in the Ports view on
  port ${port}.
EOF
fi
echo

# Open the guide once per container, when this terminal has VS Code's `code`.
# devcontainer.json opens it as a Markdown preview.
marker="${app}/tmp/.playground-guide-opened"
if [ -f "${app}/PLAYGROUND.md" ] && [ ! -e "$marker" ] && command -v code >/dev/null 2>&1; then
  timeout 5 code --reuse-window "${app}/PLAYGROUND.md" >/dev/null 2>&1 && touch "$marker"
fi

# Open the app in a browser tab as soon as it listens, when this terminal has
# VS Code's `code`: on every start by this script, so also after the
# codespace was stopped and restarted, but not on the development loop's
# restarts after a rebuild, which do not run this script. No click leads to
# that tab, so a pop-up blocker may stop it; devcontainer.json therefore has
# the port notify too, and the notification's "Open in Browser" is a click.
# The opener gives up when the server ($$ after the exec below) exits, and
# closes the lock (fd 9): it must not hold it after the server exits.
if command -v code >/dev/null 2>&1; then
  (
    began=$SECONDS
    while [ $((SECONDS - began)) -lt 300 ] && kill -0 $$ 2>/dev/null; do
      if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
        timeout 5 code --openExternal "$url"
        exit 0
      fi
      sleep 0.25
    done
  ) 9>&- </dev/null >/dev/null 2>&1 &
fi

cd "$app" || exit 1
exec cybertrain server
